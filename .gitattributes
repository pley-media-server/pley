# Normalize line endings: LF in the repository and in working trees on every
# platform (shell scripts must stay LF to run on Linux/macOS).
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.icns binary
*.gif binary
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary
*.gz binary
*.br binary

# The Android app's fixture media (scripts/make-android-fixtures.ps1), kept byte for byte.
apps/android/testing/fixtures/src/main/resources/app/pley/android/fixtures/media/** binary
