{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pley",
  "version": "0.0.1",
  "identifier": "app.pley.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run ui:dev",
    "beforeBuildCommand": "bun run ui:build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "the Pley authors",
    "copyright": "Copyright (c) 2026 the Pley authors",
    "homepage": "https://github.com/pley-media-server/pley",
    "category": "Video",
    "shortDescription": "Pley for your desktop",
    "longDescription": "A window on your Pley media server: browse your movies, shows and music, play them, and download them to watch away from home.",
    "icon": ["icons/128x128@2x.png", "icons/128x128.png", "icons/32x32.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "wix": {
        "upgradeCode": "b02fe908-68dc-5762-aa1a-aaed8498b475"
      }
    }
  }
}
