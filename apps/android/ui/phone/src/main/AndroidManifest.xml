<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Android 11 and up: the apps that open web pages are visible, so the
      sign-in screen can tell whether a browser opens a server's sign-in
      page, and offers a code only when none does.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application>
        <!--
          The phone and tablet player: it keeps playing through rotation,
          folding, a keyboard, a dark-mode change or another language, and
          shrinks into picture in picture. Phones turn it to landscape in
          code; tablets stay as they are held.
        -->
        <activity
            android:name=".player.PhonePlayerActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|locale|layoutDirection"
            android:exported="false"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.PleyPhone.Player" />

        <!--
          The live player (Live TV), as the player: through rotation and the
          rest, landscape on phones in code, into picture in picture.
        -->
        <activity
            android:name=".livetv.LivePlayerActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|locale|layoutDirection"
            android:exported="false"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="false"
            android:theme="@style/Theme.PleyPhone.Player" />
    </application>
</manifest>
