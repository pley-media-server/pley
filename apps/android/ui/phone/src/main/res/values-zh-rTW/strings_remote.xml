<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The remote of the profile's other devices: Home's button, its sheet, and the bar above the tabs while this phone controls one (apps/web/src/components/Remote.tsx). -->
    <!-- What this phone sent there with Play on… hasn't played yet. -->
    <string name="remote_starting_on">正在 %1$s 上啟動…</string>
    <string name="remote_playing_on">正在 %1$s 上播放</string>
    <string name="remote_paused_on">已在 %1$s 上暫停</string>
    <!-- What TalkBack says of Home's button. -->
    <plurals name="remote_button_playing">
        <item quantity="other">遙控器，%1$d 個裝置正在播放</item>
    </plurals>
    <plurals name="remote_button_ready">
        <item quantity="other">遙控器，%1$d 個裝置可播放</item>
    </plurals>
    <string name="remote_title">你的裝置</string>
    <string name="remote_unknown_device">未知裝置</string>
    <!-- Two devices of the same name, told apart: "Living room TV (2)". -->
    <string name="remote_device_numbered" translatable="false">%1$s (%2$d)</string>
    <string name="remote_live_tv">直播電視</string>

    <!-- A device in the list that plays nothing: only listed, it has no controls. -->
    <string name="remote_ready">可播放</string>
    <!-- A device on another profile of the household, by that profile's name; what it plays stays theirs. -->
    <string name="remote_on_profile">在 %1$s 的設定檔中</string>
    <!-- What TalkBack says a device's row, and the bar, do, and the way back from its controls. -->
    <string name="remote_open_device">顯示控制選項</string>
    <string name="remote_back_to_devices">返回裝置清單</string>

    <!-- What TalkBack says of each control: "Pause on Living room TV". -->
    <string name="remote_play">在 %1$s 上播放</string>
    <string name="remote_pause">在 %1$s 上暫停</string>
    <string name="remote_previous">在 %1$s 上播放上一個</string>
    <string name="remote_next">在 %1$s 上播放下一個</string>
    <!-- Between a channel's down and up buttons, in small capitals. -->
    <string name="remote_channel">頻道</string>
    <string name="remote_previous_channel">在 %1$s 上切換到上一個頻道</string>
    <string name="remote_next_channel">在 %1$s 上切換到下一個頻道</string>
    <string name="remote_back">在 %1$s 上後退 30 秒</string>
    <string name="remote_forward">在 %1$s 上快轉 30 秒</string>
    <string name="remote_seek">在 %1$s 上拖曳進度</string>
    <string name="remote_progress">在 %1$s 上的播放進度</string>
    <string name="remote_stop">停止</string>
    <string name="remote_stop_on">在 %1$s 上停止</string>
    <!-- Stop asks first. -->
    <string name="remote_stop_confirm">停止在 %1$s 上播放？</string>
    <string name="remote_position">%1$s / %2$s</string>
    <!-- In an intro or the credits there, as its player offers: the button, and what TalkBack says of it. -->
    <string name="remote_skip_intro">跳過片頭</string>
    <string name="remote_skip_credits">跳過片尾</string>
    <string name="remote_skip_intro_on">在 %1$s 上跳過片頭</string>
    <string name="remote_skip_credits_on">在 %1$s 上跳過片尾</string>

    <!-- The tracks and the quality a device plays, each an icon that opens a menu: its hint on a long press, and what TalkBack says. -->
    <string name="remote_audio">音訊</string>
    <string name="remote_subtitles">字幕</string>
    <string name="remote_quality">畫質</string>
    <string name="remote_subtitles_off">關閉</string>
    <string name="remote_audio_on">%1$s 的音訊</string>
    <string name="remote_subtitles_on">%1$s 的字幕</string>
    <string name="remote_quality_on">%1$s 的畫質</string>
    <string name="remote_volume_on">%1$s 的音量</string>

    <!-- A channel playing: the programme on, its times ("20:00 – 21:00"), and the one after it. -->
    <string name="remote_live_span" translatable="false">%1$s – %2$s</string>
    <string name="remote_live_next">接下來：%1$s</string>

    <!-- A command that didn't go through, said under the device's controls. -->
    <string name="remote_no_answer">%1$s 沒有回應。</string>
    <string name="remote_gone">%1$s 已停止播放。</string>
    <string name="remote_cant">%1$s 無法執行此操作。</string>
    <string name="remote_too_many">同時操作過多，請稍後再試。</string>

    <!-- Play on…: sending what a page plays to another of the profile's devices, and its chooser. -->
    <string name="play_on">在…上播放</string>
    <string name="play_on_live">在…上觀看</string>
    <string name="play_on_shuffle">在…上隨機播放</string>
    <!-- The chooser's switch: what is sent plays shuffled. -->
    <string name="play_on_shuffle_switch">隨機播放</string>
    <!-- Refused, said under the chooser's devices. -->
    <string name="play_on_gone">%1$s 已不可用。</string>
    <string name="play_on_cant">%1$s 無法播放該內容。</string>
    <!-- To a device on another profile, when this one has a PIN: the PIN pad, what it is for, and its way back. -->
    <string name="play_on_pin_title">輸入你的 PIN</string>
    <string name="play_on_pin_body">%1$s 會從 %2$s 的設定檔切換到你的設定檔。</string>
    <string name="play_on_back">返回裝置清單</string>
    <string name="play_on_wrong_pin">PIN 錯誤，請重試。</string>
    <string name="play_on_pin_locked">多次輸入錯誤後，你的 PIN 已被鎖定。你或管理員可以重設它。</string>

    <!-- A Google Cast or AirPlay device the server plays on itself: what its row says under its name. -->
    <string name="remote_google_cast">Google Cast</string>
    <string name="remote_airplay">AirPlay</string>
    <!-- Refused by a Google Cast or AirPlay device, said under the chooser's devices. -->
    <string name="play_on_unreachable">%1$s 無法連線此伺服器。</string>
    <string name="play_on_failed">%1$s 未能播放。</string>
    <string name="play_on_connections_full">%1$s 無法播放該頻道：所有直播電視連線都已佔用。</string>
    <!-- An AirPlay device the server hasn't paired with: it shows a code, typed on the pad, once for the household. -->
    <string name="play_on_pair_title">與 %1$s 配對</string>
    <string name="play_on_code_title">輸入 %1$s 顯示的驗證碼</string>
    <string name="play_on_code_body">之後家中的每個人都可以在上面播放。</string>
    <string name="play_on_show_code_again">沒有顯示驗證碼？重新顯示</string>
    <string name="play_on_wrong_code">這不是 %1$s 顯示的驗證碼。</string>
    <string name="play_on_pairing_wait">%1$s 暫時無法接受重試，請稍等。</string>
    <string name="play_on_pairing_failed">%1$s 配對失敗。</string>
    <!-- A toast: the chooser closed before an AirPlay device asked for its code. -->
    <string name="play_on_pair_first">%1$s 需要先配對：請在「在…上播放」中重新選擇它。</string>
</resources>
