    <string name="remote_forward">Forward 30 seconds on %1$s</string>
    <string name="remote_seek">Seek on %1$s</string>
    <string name="remote_progress">Progress on %1$s</string>
    <string name="remote_stop">Stop</string>
    <string name="remote_stop_on">Stop on %1$s</string>
    <string name="remote_waiting">Waiting for %1$s</string>
    <string name="remote_position">%1$s of %2$s</string>

