<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The Downloads page. -->
    <string name="downloads_title">Downloads</string>
    <string name="downloads_empty">Nothing downloaded yet</string>
    <string name="downloads_empty_body">Download a movie or episode from its page to watch it offline.</string>
    <!-- "4.2 GB on this phone · 51 GB free". -->
    <string name="downloads_storage">%1$s on this device · %2$s free</string>
    <!-- A show's group: "3 episodes · 4.2 GB". -->
    <plurals name="downloads_episodes">
        <item quantity="one">%1$d episode · %2$s</item>
        <item quantity="other">%1$d episodes · %2$s</item>
    </plurals>
