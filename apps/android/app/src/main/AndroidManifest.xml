<?xml version="1.0" encoding="utf-8"?>
<!--
  The native app: MainActivity on phones and tablets, TvActivity on Android
  TV, Google TV and Fire TV home screens. Exported, beside these two: the
  sign-in's return address (core/auth), the music service (core/player) and
  the Watch Next row's pictures (watchnext/).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 17: servers at home, found and opened (asked for before either). -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Fire OS 16: finding servers on the network; never for location. -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <!-- Fire TV below Fire OS 14: Alexa's play, pause and seek. -->
    <uses-permission android:name="com.amazon.permission.media.session.voicecommandcontrol" />
    <!--
      TVs: videos on a USB drive, asked for when its page opens. Android 13
      and later ask for videos, earlier versions for storage.
    -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <!--
      One app for phones, tablets and TVs: no remote, touchscreen or
      pointer is required, so Google Play and the Amazon Appstore offer it
      to TVs too.
    -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.faketouch"
        android:required="false" />

    <!--
      pley servers on home networks speak plain HTTP, so cleartext traffic is
      allowed. Nothing is backed up or moved to a new device: the sign-in
      module holds the app's tokens, sealed by this device's Keystore. Back
      goes through the system's callbacks (Fire OS 16 can skip onBackPressed).
      Its category is video: Android files it with the video apps (data and
      battery use, the launcher's groups). Android 10 reads a USB drive's
      folders as earlier versions do (requestLegacyExternalStorage). Android
      13 and later list its languages in the system's settings (localeConfig).
    -->
    <application
        android:name=".PleyApplication"
        android:allowBackup="false"
        android:appCategory="video"
        android:enableOnBackInvokedCallback="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pley"
        android:usesCleartextTraffic="true">

        <!-- Phones and tablets. A TV that opens it is sent on to TvActivity. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Pley.Native">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          TVs, with the 320x180 banner on Android TV's home screen. Its icon
          is the app's: Google TV's home screen draws it in a circle, and Fire
          TV's shows a sideloaded app by the app's icon in a square, between
          grey bars, whatever its shape. A remote or keyboard connecting
          doesn't restart it.
        -->
        <activity
            android:name=".TvActivity"
            android:banner="@drawable/tv_banner"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:theme="@style/Theme.Pley.Tv">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Once, after an update from the web view app: its old session ends
          and its data goes (migration/WebViewCleanup). Run by AndroidX
          Startup's provider, which the libraries already bring.

          Two of the libraries' initializers don't run as the app starts, on
          the main thread: EmojiCompat's (the system's fonts draw what titles
          hold, and Fire TV can't download its font anyway) and OkHttp's,
          which AppGraph runs where it makes the first client, off it.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="app.pley.android.migration.WebViewCleanupInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
            <meta-data
                android:name="okhttp3.internal.platform.PlatformInitializer"
                tools:node="remove" />
        </provider>

        <!--
          The pictures of the home screen's Watch Next row (Android TV and
          Google TV), which the home screen reads: read only, by names it was
          given (watchnext/WatchNextImages).
        -->
        <provider
            android:name=".watchnext.WatchNextImageProvider"
            android:authorities="${applicationId}.watchnext"
            android:exported="true" />

        <!-- The sign-in module's return address is in core/auth's manifest. -->
    </application>
</manifest>
