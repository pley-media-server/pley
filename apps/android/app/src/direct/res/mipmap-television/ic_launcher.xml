<?xml version="1.0" encoding="utf-8"?>
<!--
  The sideloaded APK's icon on TVs: the mark alone on a clear background, as
  wide as 70% of the icon. Fire TV shows a sideloaded app's tile by its icon,
  squeezed into a square in the middle, with grey on either side, and paints
  an adaptive icon's clear background black: this one is a plain vector, so
  the whole tile is the grey with the mark in it. Google TV's settings put a
  plain icon on a white plate; the stores' build keeps the adaptive icon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="1.9"
        android:scaleY="1.9"
        android:translateX="-6.8"
        android:translateY="-6.8">
        <path
            android:fillColor="#FF0C4A6E"
            android:pathData="M46 21.5h3a3 3 0 0 1 3 3v15a3 3 0 0 1-3 3h-3z" />
        <path
            android:fillColor="#FF0284C7"
            android:pathData="M36 18.5h4.5a3.5 3.5 0 0 1 3.5 3.5v20a3.5 3.5 0 0 1-3.5 3.5H36z" />
        <path
            android:fillType="evenOdd"
            android:pathData="M16 15.5h14a4 4 0 0 1 4 4v25a4 4 0 0 1-4 4H16a4 4 0 0 1-4-4v-25a4 4 0 0 1 4-4zM19 27v10a1 1 0 0 0 1.51.86l8.5-5a1 1 0 0 0 0-1.72l-8.5-5A1 1 0 0 0 19 27z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:endX="34"
                    android:endY="49"
                    android:startX="12"
                    android:startY="15"
                    android:type="linear">
                    <item android:color="#FFBAE6FD" android:offset="0" />
                    <item android:color="#FF38BDF8" android:offset="1" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
