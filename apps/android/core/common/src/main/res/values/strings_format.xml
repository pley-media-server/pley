<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The format functions' words (:core:model's format, FormatWords),
      made by formatWords(resources). The English is what FormatWords.English
      writes, word for word.
    -->

    <!-- Durations, short: "29s", "45m", "1h", "1h 52m", a server's uptime "1d 1h". -->
    <string name="format_seconds">%1$ds</string>
    <string name="format_minutes">%1$dm</string>
    <string name="format_hours">%1$dh</string>
    <string name="format_hours_minutes">%1$dh %2$dm</string>
    <string name="format_days_hours">%1$dd %2$dh</string>
    <!-- A runtime under an hour, on the TV and phone screens. -->
    <string name="format_runtime_minutes">%1$d min</string>
    <!-- What is left of something playing: "26 min left", "1h 12m left". -->
    <string name="format_left">%1$s left</string>

    <!-- Durations in words, for screen readers: "1 hour 12 minutes", "34 minutes left" (after a comma). -->
    <plurals name="format_spoken_seconds">
        <item quantity="one">%1$d second</item>
        <item quantity="other">%1$d seconds</item>
    </plurals>
    <plurals name="format_spoken_minutes">
        <item quantity="one">%1$d minute</item>
        <item quantity="other">%1$d minutes</item>
    </plurals>
    <plurals name="format_spoken_hours">
        <item quantity="one">%1$d hour</item>
        <item quantity="other">%1$d hours</item>
    </plurals>
    <string name="format_spoken_hours_minutes">%1$s %2$s</string>
    <string name="format_spoken_left">%1$s left</string>

    <!-- Relative times, as Intl.RelativeTimeFormat words them (numeric "auto"), in lower case. -->
    <string name="format_never">never</string>
    <string name="format_now">now</string>
    <string name="format_this_minute">this minute</string>
    <string name="format_this_hour">this hour</string>
    <string name="format_today">today</string>
    <string name="format_this_week">this week</string>
    <string name="format_this_month">this month</string>
    <string name="format_this_year">this year</string>
    <string name="format_yesterday">yesterday</string>
    <string name="format_last_week">last week</string>
    <string name="format_last_month">last month</string>
    <string name="format_last_year">last year</string>
    <string name="format_tomorrow">tomorrow</string>
    <string name="format_next_week">next week</string>
    <string name="format_next_month">next month</string>
    <string name="format_next_year">next year</string>
    <plurals name="format_seconds_ago">
        <item quantity="one">%1$d second ago</item>
        <item quantity="other">%1$d seconds ago</item>
    </plurals>
    <plurals name="format_minutes_ago">
        <item quantity="one">%1$d minute ago</item>
        <item quantity="other">%1$d minutes ago</item>
    </plurals>
    <plurals name="format_hours_ago">
        <item quantity="one">%1$d hour ago</item>
        <item quantity="other">%1$d hours ago</item>
    </plurals>
    <plurals name="format_days_ago">
        <item quantity="one">%1$d day ago</item>
        <item quantity="other">%1$d days ago</item>
    </plurals>
    <plurals name="format_weeks_ago">
        <item quantity="one">%1$d week ago</item>
        <item quantity="other">%1$d weeks ago</item>
    </plurals>
    <plurals name="format_months_ago">
        <item quantity="one">%1$d month ago</item>
        <item quantity="other">%1$d months ago</item>
    </plurals>
    <plurals name="format_years_ago">
        <item quantity="one">%1$d year ago</item>
        <item quantity="other">%1$d years ago</item>
    </plurals>
    <plurals name="format_in_seconds">
        <item quantity="one">in %1$d second</item>
        <item quantity="other">in %1$d seconds</item>
    </plurals>
    <plurals name="format_in_minutes">
        <item quantity="one">in %1$d minute</item>
        <item quantity="other">in %1$d minutes</item>
    </plurals>
    <plurals name="format_in_hours">
        <item quantity="one">in %1$d hour</item>
        <item quantity="other">in %1$d hours</item>
    </plurals>
    <plurals name="format_in_days">
        <item quantity="one">in %1$d day</item>
        <item quantity="other">in %1$d days</item>
    </plurals>
    <plurals name="format_in_weeks">
        <item quantity="one">in %1$d week</item>
        <item quantity="other">in %1$d weeks</item>
    </plurals>
    <plurals name="format_in_months">
        <item quantity="one">in %1$d month</item>
