    <!-- Seasons and episodes: "S1 · E3", "S1", "E3", "Season 2", "Episode 5", "Season" without a number, season 0. -->
    <string name="format_season_episode">S%1$d · E%2$d</string>
    <string name="format_season_short">S%1$d</string>
    <string name="format_episode_short">E%1$d</string>
    <string name="format_season">Season %1$d</string>
    <string name="format_episode">Episode %1$d</string>
    <string name="format_season_unnumbered">Season</string>
    <string name="format_specials">Specials</string>
    <!-- Counts under a card, the number written in the language's digits ("12,345"). -->
    <plurals name="format_seasons">
        <item quantity="one">%1$s season</item>
        <item quantity="other">%1$s seasons</item>
    </plurals>
    <plurals name="format_episodes">
        <item quantity="one">%1$s episode</item>
        <item quantity="other">%1$s episodes</item>
    </plurals>
    <plurals name="format_albums">
        <item quantity="one">%1$s album</item>
        <item quantity="other">%1$s albums</item>
    </plurals>
    <!-- A tile's state, for screen readers: "Severance, 2 seasons, 6 unwatched". -->
    <string name="format_watched">watched</string>
    <plurals name="format_unwatched">
        <item quantity="one">%1$d unwatched</item>
        <item quantity="other">%1$d unwatched</item>
    </plurals>

    <!-- Tracks and files: "English (AAC Stereo)", "Unknown (5ch)", "French (SRT, Forced, External)", "10-bit". -->
    <string name="format_unknown">Unknown</string>
    <string name="format_stereo">Stereo</string>
    <string name="format_channels">%1$dch</string>
    <string name="format_forced">Forced</string>
    <string name="format_external">External</string>
    <string name="format_bit_depth">%1$d-bit</string>
    <string name="format_bitrate_unknown">Bitrate unknown</string>
    <string name="format_version">Version %1$d</string>
    <!-- The library filter by dynamic range that takes any of them. -->
    <string name="format_any_hdr">Any HDR</string>
    <!-- Sizes and rates: "1.5 KB", "8.2 Mbps". -->
    <string name="format_bytes">%1$s B</string>
    <string name="format_kilobytes">%1$s KB</string>
    <string name="format_megabytes">%1$s MB</string>
    <string name="format_gigabytes">%1$s GB</string>
    <string name="format_terabytes">%1$s TB</string>
    <string name="format_megabits">%1$s Mbps</string>
    <string name="format_kilobits">%1$s kbps</string>

    <!-- What the transcoder does, in the player's details: "HEVC (copy)", "cuda decode", "burn-in subs". -->
    <string name="format_video_transcode">Video transcode</string>
    <string name="format_video">Video</string>
    <string name="format_copied">%1$s (copy)</string>
    <string name="format_decoded">%1$s decode</string>
    <string name="format_burn_in">burn-in subs</string>

    <!-- A stream's technical details: "Main 10 · Level 5.1", "23.976 fps", Dolby Vision in full. -->
    <string name="format_level">Level %1$s</string>
    <string name="format_frame_rate">%1$s fps</string>
    <string name="format_dv_profile">Profile %1$s</string>
    <string name="format_dv_base_layer">%1$s-compatible base layer</string>
    <string name="format_dv_no_base_layer">no compatible base layer</string>
    <string name="format_dv_full_layer">full enhancement layer</string>
    <string name="format_dv_minimal_layer">minimal enhancement layer</string>

    <!-- Tracks' languages Pley names itself (und, mul, zxx, qaa, cmn); the others are named by the system. -->
    <string name="format_language_und">Unknown</string>
    <string name="format_language_mul">Multiple</string>
    <string name="format_language_zxx">No linguistic content</string>
    <string name="format_language_qaa">Original</string>
    <string name="format_language_cmn">Mandarin</string>
</resources>
