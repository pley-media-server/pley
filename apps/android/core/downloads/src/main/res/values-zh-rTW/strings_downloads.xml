<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The notification's channel, in the system's settings. -->
    <string name="downloads_channel">下載</string>
    <string name="downloads_channel_description">下載進度</string>

    <string name="downloads_notification_downloading">正在下載 %1$s</string>
    <!-- "1.2 GB of 4.6 GB". -->
    <string name="downloads_notification_progress">%1$s / %2$s</string>
    <!-- "1.2 GB of 4.6 GB · 2 more". -->
    <string name="downloads_notification_progress_more">%1$s / %2$s · 還有 %3$d 項</string>
    <string name="downloads_notification_waiting">下載正在等待 Wi-Fi</string>
    <string name="downloads_notification_waiting_text">連線 Wi-Fi 後會繼續；若設定中允許，也會使用行動數據繼續。</string>
    <!-- The server didn't answer: away from home, or it is off. -->
    <string name="downloads_notification_waiting_server">下載正在等待你的伺服器</string>
    <string name="downloads_notification_waiting_server_text">伺服器恢復回應後會繼續，就像在家開啟應用時一樣。</string>
    <string name="downloads_notification_starting">正在準備下載</string>
    <!-- While the server makes a smaller (or playable) file for this phone. -->
    <string name="downloads_notification_converting">正在準備 %1$s</string>
    <string name="downloads_notification_converting_text">伺服器正在為此手機處理 · %1$d%%</string>

    <!--
      Why a download failed (Failure), one sentence without its full stop:
      the screens put it after "Didn't download:".
    -->
    <string name="downloads_error_missing">下載的檔案已丟失</string>
    <string name="downloads_error_no_space">此裝置儲存空間不足</string>
    <string name="downloads_error_no_conversions">伺服器無法產生更小的下載檔案：請在 設定 → 下載 中選擇「原始」</string>
    <string name="downloads_error_conversion">伺服器無法為此裝置處理該檔案</string>
    <!-- %1$s: the server's own words, as it wrote them. -->
    <string name="downloads_error_conversion_said">伺服器無法為此裝置處理該檔案：%1$s</string>
    <string name="downloads_error_sign_in">請重新登入伺服器後再下載</string>
    <string name="downloads_error_gone">此檔案已不在伺服器上</string>
    <!-- %1$d: the server's answer, "502". -->
    <string name="downloads_error_server">伺服器無法傳送此檔案（%1$d）</string>
</resources>
