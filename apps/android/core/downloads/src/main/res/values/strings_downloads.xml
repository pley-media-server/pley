<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="MissingTranslation">
    <!-- The notification's channel, in the system's settings. -->
    <string name="downloads_channel">Downloads</string>
    <string name="downloads_channel_description">How far downloads are</string>

    <string name="downloads_notification_downloading">Downloading %1$s</string>
    <!-- "1.2 GB of 4.6 GB". -->
    <string name="downloads_notification_progress">%1$s of %2$s</string>
    <!-- "1.2 GB of 4.6 GB · 2 more". -->
    <string name="downloads_notification_progress_more">%1$s of %2$s · %3$d more</string>
    <string name="downloads_notification_waiting">Downloads are waiting for Wi-Fi</string>
    <string name="downloads_notification_waiting_text">They\'ll resume on Wi-Fi, or on mobile data if allowed in Settings.</string>
    <!-- The server didn't answer: away from home, or it is off. -->
    <string name="downloads_notification_waiting_server">Downloads are waiting for your server</string>
    <string name="downloads_notification_waiting_server_text">They go on once it answers again, as when the app opens at home.</string>
    <string name="downloads_notification_starting">Getting downloads ready</string>
    <!-- While the server makes a smaller (or playable) file for this phone. -->
    <string name="downloads_notification_converting">Preparing %1$s</string>
    <string name="downloads_notification_converting_text">The server is making it for this phone · %1$d%%</string>
</resources>
