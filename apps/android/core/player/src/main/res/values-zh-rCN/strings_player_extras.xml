<?xml version="1.0" encoding="utf-8"?>
<!-- The sleep timer, subtitle sync and a playback stopped by the server, shared by the phone and the TV. -->
<resources>
    <!-- A playback the server stopped (docs/API.md, DELETE /api/sessions/{id}). -->
    <string name="session_stopped_by_admin">播放已被服务器管理员停止。</string>
    <string name="session_stopped_elsewhere">播放已被另一台设备停止。</string>
    <string name="live_stopped_by_admin">直播电视已被服务器管理员停止。</string>
    <string name="live_stopped_elsewhere">直播电视已被另一台设备停止。</string>
    <!-- Who stopped it, then their message on its own line. -->
    <string name="session_stopped_message" translatable="false">%1$s\n%2$s</string>
    <!-- A channel's stream refused with no sentence of the server's: its HTTP status, "The server answered 503." -->
    <string name="live_server_answered">服务器返回 %1$d。</string>

    <!-- Something another of the profile's devices sent here (Play on…), said a few seconds as it starts: the device. -->
    <string name="cast_playing_from">正在播放来自 %1$s 的内容</string>
    <string name="cast_playing_from_another">正在播放来自另一台设备的内容</string>
    <!-- Sent from a remote on another profile of the household, which this device couldn't switch to: nothing plays. -->
    <string name="cast_switch_failed">无法切换到遥控器所在的配置文件</string>

    <!-- What the profile's remote, on another device, just did here, said for a moment in place of the controls. -->
    <string name="session_remote_paused">已暂停</string>
    <string name="session_remote_playing">正在播放</string>
    <!-- A skip by the remote, as far as it asked: "+30 s", "−10 s" (a true minus sign). -->
    <string name="session_remote_skipped_forward">+%1$d 秒</string>
    <string name="session_remote_skipped_back">−%1$d 秒</string>
    <!-- A seek by the remote: where it went, "Jumped to 12:34". -->
    <string name="session_remote_jumped">已跳转到 %1$s</string>
    <!-- A track or quality the remote picked, as the player's menu names it. -->
    <string name="session_remote_audio">音频：%1$s</string>
    <string name="session_remote_subtitles">字幕：%1$s</string>
    <string name="session_remote_subtitles_off">关闭字幕</string>
    <string name="session_remote_quality">画质：%1$s</string>

    <!-- The sleep timer's choices. -->
    <string name="sleep_timer">睡眠定时器</string>
    <string name="sleep_off">关闭</string>
    <string name="sleep_minutes">%1$d 分钟</string>
    <string name="sleep_end_of_episode">本集结束</string>
    <string name="sleep_end_of_track">本曲目结束</string>
    <!-- The timer running, beside its row: "42 min left". -->
    <plurals name="sleep_minutes_left">
        <item quantity="other">剩余 %1$d 分钟</item>
    </plurals>
    <!-- 30 s before the timer pauses. -->
    <string name="sleep_notice">%1$d 秒后暂停</string>
    <string name="sleep_keep_watching">继续观看</string>
    <string name="sleep_keep_listening">继续收听</string>

    <!-- Subtitle sync: moves the subtitles in time. -->
</resources>
