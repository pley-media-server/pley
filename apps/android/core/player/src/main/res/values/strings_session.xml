<?xml version="1.0" encoding="utf-8"?>
<!-- What the playback session says, in the web player's words (apps/web/src/player). -->
<resources>
    <!--
      Qualities, in the menu's order (docs/QUALITY.md). A conversion is
      named by its bitrate and lines, the same in every language, as the
      web app names it.
    -->
    <string name="session_quality_original">Original</string>
    <string name="session_quality_automatic">Automatic</string>
    <string name="session_quality_30m" translatable="false">30 Mbps 4K</string>
    <string name="session_quality_15m" translatable="false">15 Mbps 4K</string>
    <string name="session_quality_20m" translatable="false">20 Mbps 1080p</string>
    <string name="session_quality_12m" translatable="false">12 Mbps 1080p</string>
    <string name="session_quality_8m" translatable="false">8 Mbps 1080p</string>
    <string name="session_quality_4m" translatable="false">4 Mbps 720p</string>
    <string name="session_quality_2m" translatable="false">2 Mbps 480p</string>
    <!-- A quality taller than the file, named by the file's lines: "8 Mbps 720p". -->
    <string name="session_quality_named" translatable="false">%1$d Mbps %2$s</string>
    <!-- Automatic, with what it plays now: "Automatic · Original", "Automatic · 8 Mbps 1080p". -->
    <string name="session_quality_automatic_playing">Automatic · %1$s</string>
    <!-- Automatic's hint in the quality menu. -->
    <string name="session_quality_automatic_hint">Dynamically adjust to conditions</string>
    <!-- Automatic's hint while it plays lower: "Now 8 Mbps 1080p". -->
    <string name="session_quality_automatic_now">Now %1$s</string>
    <!-- Automatic went down, said once, briefly: "Quality lowered to 8 Mbps 1080p". -->
    <string name="session_quality_lowered_notice">Quality lowered to %1$s</string>
    <!-- Why Automatic plays lower, in the details. -->
    <string name="session_quality_lowered_network">Lowered for your connection</string>
    <string name="session_quality_lowered_device">Lowered for this device</string>

    <!-- Markers (SkipButton.tsx). -->
    <string name="session_skip_intro">Skip Intro</string>
    <string name="session_skip_credits">Skip Credits</string>

    <!-- Up Next (UpNext.tsx). -->
    <string name="session_up_next">Up next</string>
    <!-- "Up next · S1 E2". -->
    <string name="session_up_next_episode">Up next · %1$s</string>
    <string name="session_last_episode">This is the last episode</string>
    <string name="session_last_in_queue">This is the last one</string>

    <!-- Tracks. -->
    <string name="session_subtitles_off">Off</string>
    <string name="session_subtitles_failed">These subtitles couldn\'t be loaded.</string>

    <!-- How it plays (PlaybackDetails.tsx). -->
    <string name="session_method_direct">Direct play</string>
    <string name="session_method_downloaded">Downloaded</string>
    <string name="session_error_download_needs_server">This download can\'t play on this device offline. Connect to your server to play it.</string>
    <!-- A video on a USB drive, which plays with no server. -->
    <string name="session_drive_unplayable">This TV can\'t play this file as it is, and a file on a drive has no server to convert it.</string>
    <string name="session_drive_stuck">This TV doesn\'t play this file: its picture never started. With no server to convert it, try another copy.</string>
    <string name="session_drive_unreadable">This video can\'t be read. The drive may have been pulled out.</string>
    <string name="session_drive_speed_undecodable">Not for this file: its sound goes to your receiver as it is, and nothing here decodes it</string>
    <string name="session_method_remux">Direct stream</string>
    <string name="session_method_transcode">Transcoding</string>
    <string name="session_method_remux_audio">Direct stream · Audio transcoding</string>
    <string name="session_fallback_unplayable">This device couldn\'t play the original file.</string>
    <string name="session_fallback_not_smooth">The original didn\'t play smoothly on this device.</string>
    <string name="session_slow_server">The server can\'t keep up with this video. Try a lower quality.</string>

    <string name="session_row_video">Video</string>
    <string name="session_row_audio">Audio</string>
    <string name="session_row_bitrate">Bitrate</string>
    <string name="session_row_encoder">Encoder</string>
    <string name="session_row_hdr">Shown as</string>
    <string name="session_row_subtitles">Subtitles</string>
    <string name="session_row_speed">Speed</string>
    <!-- "Tone mapped to SDR (libplacebo)". -->
    <string name="session_tone_mapped">SDR (tone-mapped with %1$s)</string>
    <string name="session_burned_in">Burned in</string>
    <!-- "2.5× real time". -->
    <string name="session_speed">%1$s× real time</string>
    <!-- "2.5× real time · 40 s ready". -->
    <string name="session_speed_ready">%1$s× real time · %2$d s ready</string>
    <!-- Where a transcode runs, by the server's "hybrid" and "copy" (GPU and CPU are named as they are). -->
    <string name="session_pipeline_hybrid">GPU and CPU</string>
    <string name="session_pipeline_copy">copy</string>

    <!-- The player's own lines in the details, "Label: value": the TV shows the label beside the value. -->
    <!-- "Video: video/hevc 3840×2160". -->
    <string name="session_engine_video">Video: %1$s %2$d×%3$d</string>
    <!-- "Video: video/hevc 3840×2160 23.976 fps". -->
    <string name="session_engine_video_rate">Video: %1$s %2$d×%3$d %4$s fps</string>
    <string name="session_engine_video_decoder">Video decoder: %1$s</string>
    <!-- "Audio: audio/eac3 6 ch". -->
    <string name="session_engine_audio">Audio: %1$s %2$d ch</string>
    <string name="session_engine_audio_decoder">Audio decoder: %1$s</string>
    <!-- "Dropped frames: 3 of 5000". -->
    <string name="session_engine_dropped">Dropped frames: %1$d of %2$d</string>

    <!-- Playback speed, when a download's sound keeps it at 1×, or a stream's the server couldn't convert. -->
    <string name="session_speed_undecodable">Not for this download: its sound goes to your receiver as it is, and nothing here decodes it</string>
    <string name="session_speed_unconverted">Not now: its sound goes to your receiver as it is, nothing here decodes it, and the server couldn\'t convert it</string>

    <!-- Find subtitles… (subtitles found online, docs/API.md). -->
    <string name="session_search_not_set_up">Subtitle search isn\'t set up on this server</string>
    <string name="session_search_unsupported">This server can\'t search for subtitles: it may need an update</string>
    <string name="session_search_nothing">No subtitles found for this file</string>
    <!-- "Couldn't find subtitles: no answer in time". -->
    <string name="session_search_failed">Couldn\'t find subtitles: %1$s</string>
    <string name="session_search_exact">Made for this file</string>
    <!-- Subtitles for the deaf and hard of hearing. -->
    <string name="session_search_sdh" translatable="false">SDH</string>
    <plurals name="session_search_downloads">
        <item quantity="one">%1$,d download</item>
        <item quantity="other">%1$,d downloads</item>
    </plurals>
    <string name="session_search_added">Subtitles added</string>

    <!-- Errors (VideoPlayer.tsx). -->
    <string name="session_error_unplayable">This video can\'t be played on this device.</string>
    <string name="session_error_stuck">This video doesn\'t play on this device: it stops at the same spot each time.</string>
    <string name="session_error_short">This video ends before the point it was to play from.</string>
    <string name="session_error_stopped">Playback stopped and couldn\'t get going again.</string>
    <string name="session_error_network">Check that the server is on and that this device is on its network.</string>
    <!-- "No answer in time. Check that…": why the server couldn\'t be reached, then what to check. -->
    <string name="session_error_unreachable">%1$s Check that the server is on and that this device is on its network.</string>
    <!-- "Playback failed (ERROR_CODE_DECODING_FAILED)." -->
    <string name="session_error_engine">Playback failed (%1$s).</string>
    <string name="session_error_no_file">This item has no file to play.</string>
    <!-- Play pressed with no server signed in to. -->
    <string name="session_sign_in_to_play">Sign in to play</string>
</resources>
