<?xml version="1.0" encoding="utf-8"?>
<!-- A playback stopped by the server, Live TV's details and what a remote did, shared by the phone and the TV. -->
<resources>
    <!-- A playback the server stopped (docs/API.md, DELETE /api/sessions/{id}). -->
    <string name="session_stopped_by_admin">Playback was stopped by the server\'s administrator.</string>
    <string name="session_stopped_elsewhere">Playback was stopped from another device.</string>
    <string name="live_stopped_by_admin">Live TV was stopped by the server\'s administrator.</string>
    <string name="live_stopped_elsewhere">Live TV was stopped from another device.</string>
    <!-- Who stopped it, then their message on its own line. -->
    <string name="session_stopped_message" translatable="false">%1$s\n%2$s</string>
    <!-- A channel's stream refused with no sentence of the server's: its HTTP status, "The server answered 503." -->
    <string name="live_server_answered">The server answered %1$d.</string>
    <!-- Why a channel isn't played as its provider sends it, in its Playback details (docs/API.md, "Live TV"). -->
    <string name="live_why_interlaced">Interlaced video is made progressive.</string>
    <!-- The video's codec, with its bit depth above 8: "This device doesn't play HEVC 10-bit video." -->
    <string name="live_why_video">This device doesn\'t play %1$s video.</string>
    <!-- The sound's codec: "This device doesn't play EAC3 audio." -->
    <string name="live_why_audio">This device doesn\'t play %1$s audio.</string>
    <!-- After a channel's video in its Playback details: "MPEG-2 · 720×576 · 25 fps · interlaced". -->
    <string name="live_details_interlaced">interlaced</string>

    <!-- Something another of the profile's devices sent here (Play on…), said a few seconds as it starts: the device. -->
    <string name="cast_playing_from">Playing from %1$s</string>
    <string name="cast_playing_from_another">Playing from another device</string>
    <!-- Sent from a remote on another profile of the household, which this device couldn't switch to: nothing plays. -->
    <string name="cast_switch_failed">Couldn\'t switch to the remote\'s profile</string>

    <!-- What the profile's remote, on another device, just did here, said for a moment in place of the controls. -->
    <string name="session_remote_paused">Paused</string>
    <string name="session_remote_playing">Playing</string>
    <!-- A skip by the remote, as far as it asked: "+30 s", "−10 s" (a true minus sign). -->
    <string name="session_remote_skipped_forward">+%1$d s</string>
    <string name="session_remote_skipped_back">−%1$d s</string>
    <!-- A seek by the remote: where it went, "Jumped to 12:34". -->
    <string name="session_remote_jumped">Jumped to %1$s</string>
    <!-- A track or quality the remote picked, as the player's menu names it. -->
    <string name="session_remote_audio">Audio: %1$s</string>
    <string name="session_remote_subtitles">Subtitles: %1$s</string>
    <string name="session_remote_subtitles_off">Subtitles off</string>
    <string name="session_remote_quality">Quality: %1$s</string>
</resources>
