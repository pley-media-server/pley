    <string name="library_filter_from">From %1$s</string>
    <string name="library_filter_after">After %1$s</string>
    <string name="library_filter_before">Before %1$s</string>
    <!-- %1$s: the decade's first year, "1990". -->
    <string name="library_filter_decade">The %1$ss</string>
    <string name="library_filter_at_most">At most %1$s</string>
