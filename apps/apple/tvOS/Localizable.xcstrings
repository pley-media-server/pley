    "%@. Add a library on the server, or ask its owner for one." : {
      "comment" : "Home, Libraries: no libraries; the first part is \"No libraries yet\".",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Añade una biblioteca en el servidor, o pide una a su propietario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Ajoutez une bibliothèque sur le serveur, ou demandez-en une à son propriétaire."
          }
        }
      }
    },
    "%@. Titles show here once your libraries have some." : {
      "comment" : "Home: nothing to show; the first part is \"Nothing here yet\".",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Los títulos aparecen aquí cuando tus bibliotecas tengan alguno."
