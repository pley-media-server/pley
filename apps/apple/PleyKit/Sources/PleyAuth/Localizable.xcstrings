          }
        }
      }
    },
    "the answer came from another server than the one you signed in to: try again" : {
      "comment" : "A sign-in or profile error, shown after \"Couldn't sign in:\" or on its own.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "la respuesta vino de un servidor distinto de aquel en el que iniciaste sesión: vuelve a intentarlo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "la réponse vient d’un autre serveur que celui auquel vous vous connectez : réessayez"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "响应来自另一台服务器，而不是你登录的那台：重试"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "響應來自另一臺伺服器，而不是你登入的那臺：重試"
          }
        }
      }
    },
    "the answer wasn't for this sign-in: try again" : {
