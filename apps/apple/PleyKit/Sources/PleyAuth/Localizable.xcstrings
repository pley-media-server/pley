            "state" : "translated",
            "value" : "un code PIN compte 4 à 8 chiffres"
          }
        }
      }
    },
    "that isn't a server address" : {
      "comment" : "A sign-in or profile error, shown after \"Couldn't sign in:\" or on its own.",
