          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "le code PIN de ce profil est bloqué après trop d’essais incorrects. Son propriétaire ou un administrateur peut le réinitialiser"
          }
        }
      }
    },
    "this server answered from an address that isn't on your network, without encryption: you were signed out to keep your sign-in safe" : {
      "comment" : "A sign-in or profile error, shown after \"Couldn't sign in:\" or on its own.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "este servidor respondió desde una dirección que no está en tu red, sin cifrado: se cerró tu sesión para proteger tu inicio de sesión"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ce serveur a répondu depuis une adresse qui n’est pas sur votre réseau, sans chiffrement : votre session a été fermée pour protéger votre connexion"
          }
        }
      }
    },
    "this server calls itself %@: open it by that address, or check the proxy in front of it passes Host" : {
      "comment" : "A sign-in or profile error, shown after \"Couldn't sign in:\" or on its own.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "este servidor se presenta como %@: ábrelo con esa dirección o comprueba que el proxy que tiene delante transmite Host"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ce serveur se présente comme %@ : ouvrez-le par cette adresse, ou vérifiez que le proxy placé devant lui transmet Host"
          }
        }
      }
    },
    "this server can't check PINs" : {
      "comment" : "A sign-in or profile error, shown after \"Couldn't sign in:\" or on its own.",
