          }
        }
      }
    },
    "this profile needs its password: sign in again with a code and choose it there" : {
      "comment" : "A sign-in or profile error, shown after \"Couldn't sign in:\" or on its own.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "este perfil necesita su contraseña: vuelve a iniciar sesión con un código y elígelo ahí"
          }
        },
        "fr" : {
          "stringUnit" : {
