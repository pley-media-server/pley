    "the Keychain can't be read until this device is unlocked (error %@)" : {
      "comment" : "A sign-in or profile error, shown after \"Couldn't sign in:\" or on its own.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "el llavero no se puede leer hasta que se desbloquee este dispositivo (error %@)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "le trousseau ne peut pas être lu tant que cet appareil n’est pas déverrouillé (erreur %@)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设备解锁后才能读取钥匙串（错误 %@）"
