    "%@ can't do that." : {
      "comment" : "The remote and Play on…: devices, buttons and what VoiceOver says of them.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no puede hacer eso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas faire ça."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 无法执行此操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 無法執行此操作。"
          }
        }
      }
    },
    "%@ can't play that" : {
      "comment" : "The remote and Play on…: devices, buttons and what VoiceOver says of them.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no puede reproducir eso"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas lire ça"
          }
