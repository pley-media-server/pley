    "%@ can't play the channel: all Live TV connections are in use" : {
      "comment" : "The remote and Play on…: devices, buttons and what VoiceOver says of them.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no puede reproducir el canal: todas las conexiones de TV en vivo están en uso"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas lire la chaîne : toutes les connexions TV en direct sont utilisées"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 无法播放该频道：直播电视连接已全部占用"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 無法播放該頻道：直播電視連線已全部佔用"
          }
        }
      }
    },
    "%@ can't reach this server" : {
