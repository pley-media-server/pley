        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur a cessé de le préparer pour cet appareil"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器已停止为此设备准备"
