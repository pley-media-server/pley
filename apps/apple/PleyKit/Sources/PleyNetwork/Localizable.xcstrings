{
  "sourceLanguage" : "en",
  "strings" : {
    "Pley isn't allowed to reach your local network: allow it in Settings → Privacy & Security → Local Network" : {
      "comment" : "A connection or server error, lower case: shown after \"Couldn't …:\" or made a sentence.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pley no tiene permiso para acceder a tu red local: permítelo en Ajustes → Privacidad y seguridad → Red local"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pley n’est pas autorisé à accéder à votre réseau local : autorisez-le dans Réglages → Confidentialité et sécurité → Réseau local"
          }
        }
      }
    },
