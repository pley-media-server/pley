    "%@. Add a library on the server, or ask its owner for one." : {
      "comment" : "Home and Libraries with no library: the title, \"No libraries yet\", then how to get one.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Añade una biblioteca en el servidor, o pide una a su propietario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Ajoutez une bibliothèque sur le serveur, ou demandez-en une à son propriétaire."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。在服务器上添加媒体库，或向所有者索取。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。在伺服器上新增媒體庫，或向所有者索取。"
          }
        }
      }
    },
    "%@. Titles show here once your libraries have some." : {
      "comment" : "Home with nothing yet: the title, \"Nothing here yet\", then why.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Los títulos aparecen aquí cuando tus bibliotecas tengan alguno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Les titres s’affichent ici dès que vos bibliothèques en ont."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。媒体库中有内容后，标题会显示在这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。媒體庫中有內容後，標題會顯示在這裡。"
          }
        }
      }
    },
