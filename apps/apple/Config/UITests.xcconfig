// The iPhone and iPad screens' UI tests (UITests/): they drive the Pley
// app on a simulator against a test server (scripts/check-screens.sh).

#include "Signing.xcconfig"

PRODUCT_NAME = PleyUITests
SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
TARGETED_DEVICE_FAMILY = 1,2
IPHONEOS_DEPLOYMENT_TARGET = 16.0
TEST_TARGET_NAME = Pley
PRODUCT_BUNDLE_IDENTIFIER = $(PLEY_BUNDLE_ID).uitests
GENERATE_INFOPLIST_FILE = YES
SWIFT_VERSION = 6.0
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks @loader_path/Frameworks
