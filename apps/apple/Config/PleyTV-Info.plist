<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Pley finds Pley servers on your network and connects to the one you choose.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_pley._tcp</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.pley.apple.shelf</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>app.pley.apple</string>
			</array>
		</dict>
	</array>
	<key>PleyAppGroup</key>
	<string>group.$(PLEY_BUNDLE_ID)</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
