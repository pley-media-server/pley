<?xml version="1.0" encoding="utf-8"?>
<!-- The version is the app's, as Directory.Build.props has it. -->
<manifest package="app.pley.tizen" version="0.0.1" api-version="9.0" xmlns="http://tizen.org/ns/packages">
  <profile name="tv" />
  <ui-application appid="app.pley.tizen" exec="Pley.Tv.Tizen.dll" multiple="false" nodisplay="false" taskmanage="true" type="dotnet-nui" launch_mode="single">
    <!-- Beside the web app on the same TV, so the two can be told apart. -->
    <label>Pley (native)</label>
    <icon>icon.png</icon>
    <!-- Its code compiled as it's installed, not as it first runs: compiled as it ran, the player
         took about ten times as long to open the first time, and the app seconds to reach its own
         code. -->
    <metadata key="http://tizen.org/metadata/prefer_dotnet_aot" value="true" />
  </ui-application>
  <privileges>
    <privilege>http://tizen.org/privilege/internet</privilege>
    <!-- The TV's own address and network: the address pad's first digits, and searching the network. -->
    <privilege>http://tizen.org/privilege/network.get</privilege>
  </privileges>
</manifest>
