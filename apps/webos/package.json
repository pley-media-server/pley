{
  "name": "pley-webos",
  "private": true,
  "version": "0.1.1",
  "description": "Pley for LG TVs: a webOS web app that plays through LG's own media pipeline.",
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.mjs",
    "package": "bun scripts/build.mjs && bun scripts/package.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "tsc -p tsconfig.json && vitest run",
    "serve": "bun scripts/build.mjs --dev && bun scripts/serve.mjs"
  },
  "dependencies": {
    "pley-tv": "*"
  },
  "devDependencies": {
    "@webos-tools/cli": "^3.2.6",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
