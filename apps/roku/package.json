{
  "name": "pley-roku",
  "private": true,
  "version": "0.1.3",
  "description": "Pley for Roku: a native SceneGraph app",
  "scripts": {
    "compile": "bsc --create-package false --copy-to-staging false",
    "lint": "bslint --project bsconfig.lint.json",
    "test": "node scripts/test.mjs",
    "check": "bun run compile && bun run lint && bun run test",
    "smoke": "node scripts/smoke.mjs",
    "preview": "node scripts/preview.mjs",
    "package": "bsc --create-package --out-file out/pley-roku.zip",
    "images": "python scripts/make_images.py",
    "bench": "node scripts/bench.mjs"
  },
  "devDependencies": {
    "@rokucommunity/bslint": "0.8.46",
    "brighterscript": "0.73.5",
    "brs-node": "2.6.0"
  }
}
