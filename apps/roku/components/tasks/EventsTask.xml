<?xml version="1.0" encoding="utf-8"?>
<!-- Follows the server's event stream (EventsTask.brs, lib/Events.brs)
     while signed in to an http:// server. -->
<component name="EventsTask" extends="Task">
    <interface>
        <!-- The server and the access token: a change connects again. "" for
             either stops following. -->
        <field id="server" type="string" />
        <field id="token" type="string" />
        <field id="userAgent" type="string" />
        <!-- The stream's query: this Roku as a receiver of casts
             (Cast.brs's castReceiverQuery). A change connects again, so
             remotes learn what it takes now. -->
        <field id="query" type="string" />
        <!-- The token the server refused (it ran out while nothing else
             asked the server): the scene has it renewed. -->
        <field id="tokenRefused" type="string" alwaysNotify="true" />
        <!-- The token of a stream that failed or ended: the scene has the
             API task ask the server, so that when nothing answers the token
             waits for the server to prove itself again. -->
        <field id="failed" type="string" alwaysNotify="true" />
        <!-- Each ServerEvent as it comes. -->
        <field id="event" type="assocarray" alwaysNotify="true" />
        <!-- The stream is up: the server answered, and tells what changes.
             false while it isn't (an https server, or connecting again),
             when the scene asks for itself. -->
        <field id="live" type="boolean" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/tasks/EventsTask.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/I18n.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Url.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Http.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Events.brs" />
</component>
