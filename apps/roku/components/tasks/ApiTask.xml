<?xml version="1.0" encoding="utf-8"?>
<!-- The one place that talks to the server (ApiTask.brs). Screens hand it
     ApiRequest nodes through `request` (components/shared/Ui.brs). -->
<component name="ApiTask" extends="Task">
    <interface>
        <field id="request" type="node" alwaysNotify="true" />
        <!-- Set once the task listens: a request set before is never seen. -->
        <field id="ready" type="boolean" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/tasks/ApiTask.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Url.brs" />
