<?xml version="1.0" encoding="utf-8"?>
<!-- The app's one scene: it starts the API task and keeps the stack of
     screens; Back on the first screen leaves the app. -->
<component name="MainScene" extends="Scene">
    <interface>
        <!-- Roku's AppLaunchComplete went (uiLaunched). -->
        <field id="launched" type="boolean" />
        <!-- Playbacks so far: Home asks for its rows again after one. -->
        <field id="played" type="integer" />
        <!-- The libraries' order saved so far: Home asks again after one. -->
        <field id="librariesMoved" type="integer" />
        <!-- Changes the server's event stream told of (other devices'): Home
             asks again after one. -->
        <field id="remoteChanges" type="integer" />
        <!-- The latest titles marked watched or unwatched, played, put in
             My List or taken out, or out of Continue Watching
             ([{ count, itemId, action }], Ui.brs's uiNoteChange): the
             screens showing them follow. -->
        <field id="changes" type="array" />
        <field id="changeCount" type="integer" />
        <!-- "Who's watching?" was answered in this launch (a profile
             chosen, a PIN checked, or a sign-in with a code): the PIN of
             the profile signed in isn't asked again. -->
        <field id="profileChosen" type="boolean" />
        <!-- The ids in My List as Home last saw them, for the Options key. -->
        <field id="myList" type="array" />
        <!-- The Live TV channel watched last in this launch: Live TV opens back
             at it. -->
        <field id="liveChannel" type="integer" />
        <!-- What requests let the profile signed in do (lib/Requests.brs's
             reqSummary; known false until the server said): the menu's
             Discover and requests, and their number. -->
        <field id="requestSummary" type="assocarray" />
        <!-- A title's request changed ({ key, status, libraryId },
             uiNoteRequest): the screens showing its tile give it its
             badge. -->
        <field id="requestNote" type="assocarray" alwaysNotify="true" />
        <!-- A screen did something to a request ({ requestId (0 for
             none), kind, tmdbId }): the summary is asked at once, and
             without the event stream the request's title gets its badge
             where it shows. -->
        <field id="requestTouched" type="assocarray" alwaysNotify="true" />
        <!-- The server's event stream is up: what changes elsewhere is
             told, so pages showing requests need not ask on their own. -->
        <field id="eventsLive" type="boolean" />
        <!-- This Roku's id for casting while the event stream lists it, ""
             otherwise: the player tells what it plays to that id. -->
        <field id="castDevice" type="string" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Ui.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Url.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Http.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nav.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Events.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Cast.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Format.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Player.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Content.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Requests.brs" />
    <children>
        <Group id="screens" />
        <Timer id="gather" duration="0.3" />
        <!-- Request events, gathered for a second: the summary is asked
             once for those that come together. -->
        <Timer id="requestGather" duration="1" />
        <!-- Without the event stream, the summary each minute. -->
        <Timer id="requestPoll" duration="60" repeat="true" />
    </children>
</component>
