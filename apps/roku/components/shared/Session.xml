<?xml version="1.0" encoding="utf-8"?>
<!-- What every screen knows of the server and the sign-in, as m.global.session.
     Only the API task writes it; the screens observe it. -->
<component name="Session" extends="Node">
    <interface>
        <field id="server" type="string" />
        <field id="serverName" type="string" />
        <field id="signedIn" type="boolean" alwaysNotify="true" />
        <!-- "ended" (by the server), "wider_scope", "signed_out" (by the person) -->
        <field id="signOutReason" type="string" />
        <!-- What the sign-in was allowed: "library play playlists profiles". -->
        <field id="scope" type="string" />
        <!-- The current access token, for the HTTP agents of pictures and video. -->
        <field id="accessToken" type="string" />
        <field id="userAgent" type="string" />
        <!-- This Roku as its players name it to the server: its client_id,
             and the name its owner gave it ("" for none, Remote.brs's
             remoteDeviceName). The event stream says it takes casts by
             them. -->
        <field id="playerId" type="string" />
        <field id="deviceName" type="string" />
        <field id="appVersion" type="string" />
        <field id="device" type="string" />
        <!-- The profile signed in (GET /api/auth/me), once the server said:
             0 and "" until then. -->
        <field id="profileId" type="integer" />
        <field id="profileName" type="string" />
    </interface>
</component>
