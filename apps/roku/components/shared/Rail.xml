<?xml version="1.0" encoding="utf-8"?>
<!-- The rail at the left of the browsing pages, as the Android TV app's
     shell has it (TvRail): the profile's initial, Search, Home, Discover and
     the requests, Live TV, the libraries, Playlists, Collections, Now
     Playing and Settings (Home.brs's homeMenu), their icons in a 144 px
     column over the page's dark, the current page's marked. With the focus
     it opens over the page, a panel of surface with their names. The scene
     gives it the focus (Left at a page's edge) and takes it back (Right,
     Back). -->
<component name="Rail" extends="Group">
    <interface>
        <!-- [{ title, action, icon, initial, library, count, danger }]. -->
        <field id="entries" type="array" onChange="onEntries" />
        <!-- The current page's entry key ("home", "library:3", "search"). -->
        <field id="current" type="string" onChange="onCurrent" />
        <!-- The entry OK was pressed on (its fields), and a wish to give the
             focus back to the page (Right, Back). -->
        <field id="chosen" type="assocarray" alwaysNotify="true" />
        <field id="leave" type="boolean" alwaysNotify="true" />
        <!-- Whether the page is Home, where Back on the rail leaves the app,
             as Back on a first screen does. -->
        <field id="home" type="boolean" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/shared/Rail.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/I18n.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Url.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Http.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nodes.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nav.brs" />
    <children>
        <!-- The page's dark under the collapsed icons, clear by the pages'
             gutter. -->
        <Poster id="shade" width="184" height="1080" uri="pkg:/images/ui/fade-left.png" />
        <Group id="panel" opacity="0">
            <Rectangle width="520" height="1080" color="0x1E222AFF" />
            <Poster translation="[520, 0]" width="48" height="1080" uri="pkg:/images/ui/shadow.png" />
        </Group>
        <MarkupList id="list" translation="[0, 144]" itemComponentName="RailRow" itemSize="[520, 80]" itemSpacing="[0, 8]" numRows="10" drawFocusFeedback="false" vertFocusAnimationStyle="floatingFocus" />
        <Animation id="opening" duration="0.15" easeFunction="outCubic">
            <FloatFieldInterpolator key="[0, 1]" keyValue="[0, 1]" fieldToInterp="panel.opacity" />
        </Animation>
        <Animation id="closing" duration="0.12" easeFunction="inCubic">
            <FloatFieldInterpolator key="[0, 1]" keyValue="[1, 0]" fieldToInterp="panel.opacity" />
        </Animation>
    </children>
</component>
