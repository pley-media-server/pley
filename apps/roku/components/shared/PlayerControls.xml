<?xml version="1.0" encoding="utf-8"?>
<!-- The player's controls, drawn as the Android TV player's (TvPlayerControls.kt),
     over the Video node, whose own are off: the title, how it plays and the
     clock at the top; the scrubber with its times, the chapters' gaps and
     the intro's or credits' name under it; the seek preview over it while
     a seek is coming; the row of buttons (the sleep timer and chapters at
     the left, previous, play or pause and next in the middle, subtitles,
     audio, quality and info at the right), whose focused one fills with
     the accent and says its name. With the controls hidden: the seek
     badge ("+30 s") and the loading ring. The player keeps the remote and
     says what has the focus (focusKey); this only draws. -->
<component name="PlayerControls" extends="Group">
    <interface>
        <field id="title" type="string" onChange="onTop" />
        <field id="line" type="string" onChange="onTop" />
        <!-- How it plays, badged ("Direct play"), and its kind ("direct",
             "remux", "transcode") for the badge's color. -->
        <field id="method" type="string" onChange="onTop" />
        <field id="methodKind" type="string" onChange="onTop" />
        <field id="durationMs" type="integer" onChange="onTrack" />
        <field id="positionMs" type="integer" onChange="onTrack" />
        <!-- Where a seek coming goes (-1: none): the scrubber, its times
             and the preview stand there. -->
        <field id="targetMs" type="integer" value="-1" onChange="onTrack" />
        <!-- Chapters' starts (ms), for the scrubber's gaps. -->
        <field id="chapters" type="array" onChange="onChapters" />
        <!-- The intro and credits: [{ startMs, endMs, label }]. -->
        <field id="markers" type="array" onChange="onTrack" />
        <!-- Whether it plays (Play/Pause shows Pause), and whether it is
             paused, which says when it ends. -->
        <field id="playing" type="boolean" onChange="onPlaying" />
        <field id="paused" type="boolean" onChange="onTop" />
        <!-- The row's buttons, in order: [{ id, icon, label, group }], the
             group "left", "center" or "right". -->
        <field id="buttons" type="array" onChange="onButtons" />
        <!-- What has the focus: "scrubber", a button's id, or "". -->
        <field id="focusKey" type="string" onChange="onFocusKey" />
        <!-- The seek preview's picture (its cut file, or "" for none yet), the time
             it shows and its chapter. -->
        <field id="previewUri" type="string" onChange="onPreview" />
        <field id="previewChapter" type="string" onChange="onPreview" />
        <field id="previewsReady" type="boolean" onChange="onTrack" />
        <!-- The controls show (they fade in and out). -->
        <field id="shown" type="boolean" onChange="onShown" />
        <!-- The seek badge with the controls hidden: "+30 s" ("" for
             none), forward or not. -->
        <field id="badge" type="string" onChange="onBadge" />
        <field id="badgeForward" type="boolean" />
        <!-- The loading ring, with what to say under it ("" for nothing). -->
        <field id="buffering" type="boolean" onChange="onBuffering" />
        <field id="bufferingText" type="string" onChange="onBuffering" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/shared/PlayerControls.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Paint.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Colors.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/I18n.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Url.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Http.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Format.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Type.brs" />
    <children>
        <Group id="controls" opacity="0" visible="false">
            <Poster id="scrim" width="1920" height="1080" uri="pkg:/images/ui/scrim-player.png" />
            <!-- The top: the title and the episode's line at the left; how
                 it plays and the clock at the right, when it ends under
                 them while paused. -->
            <Label id="title" translation="[96, 54]" width="1300" maxLines="1" color="0xE9EBEFFF" />
            <Label id="line" translation="[96, 106]" width="1300" maxLines="1" color="0xA1A9B6FF" />
            <Label id="clock" translation="[1424, 60]" width="400" horizAlign="right" color="0xA1A9B6FF" />
            <MethodBadge id="method" visible="false" />
            <Label id="endsAt" translation="[1224, 112]" width="600" horizAlign="right" color="0xA1A9B6FF" visible="false" />
            <!-- The scrubber, x 96 to 1824, its track's center at y 850. -->
            <Label id="elapsed" translation="[96, 798]" color="0xE9EBEFFF" />
            <Label id="remaining" translation="[1324, 798]" width="500" horizAlign="right" color="0xE9EBEFFF" />
            <Poster id="track" translation="[96, 846]" width="1728" height="8" uri="pkg:/images/ui/bar.9.png" blendColor="0xE9EBEF40" />
            <Poster id="played" translation="[96, 846]" width="0" height="8" uri="pkg:/images/ui/bar.9.png" blendColor="0x38BDF8FF" />
            <Group id="gaps" />
            <Poster id="thumb" translation="[86, 840]" width="20" height="20" uri="pkg:/images/ui/thumb.png" blendColor="0xE9EBEFFF" />
            <!-- Focused, the thumb grows to 24 px with an accent-hover ring
                 4 px out. -->
            <Group id="thumbFocus" translation="[78, 832]" visible="false">
                <Poster translation="[6, 6]" width="24" height="24" uri="pkg:/images/ui/thumb.png" blendColor="0xE9EBEFFF" />
                <Poster width="36" height="36" uri="pkg:/images/ui/thumb-ring.png" blendColor="0x7DD3FCFF" />
            </Group>
            <Label id="marker" translation="[96, 866]" horizAlign="center" color="0xA1A9B6FF" visible="false" />
            <!-- The seek preview, 480 × 270, its bottom at y 694, over the
                 thumb; the time under it and the chapter's name. -->
            <Group id="preview" visible="false">
                <Rectangle id="previewWell" width="480" height="270" color="0x191D24FF" />
                <Poster id="previewImage" width="480" height="270" loadDisplayMode="scaleToFit" loadWidth="480" loadHeight="270" />
                <Poster id="previewFrame" width="480" height="270" uri="pkg:/images/ui/frame.9.png" blendColor="0xE9EBEF33" />
                <Label id="previewTime" translation="[0, 282]" width="480" horizAlign="center" color="0xE9EBEFFF" />
                <Label id="previewChapter" translation="[0, 320]" width="480" horizAlign="center" maxLines="1" color="0xA1A9B6FF" />
            </Group>
            <!-- The row of buttons, its top at y 882. -->
            <Group id="row" />
        </Group>
        <!-- The seek badge with the controls hidden: 128 square, bg at 60 %,
             centered in the left or right third. -->
        <Group id="badge" visible="false">
            <Poster id="badgeBack" width="128" height="128" uri="pkg:/images/ui/r12.9.png" blendColor="0x0B0D1099" />
            <Label id="badgeText" width="128" height="128" horizAlign="center" vertAlign="center" color="0xE9EBEFFF" />
        </Group>
        <!-- Loading: an 80 px ring in the middle, a quarter of it turning,
             what to say under it on the badge's backing. -->
        <Group id="buffering" visible="false">
            <Poster translation="[920, 500]" width="80" height="80" uri="pkg:/images/ui/buffering-track.png" blendColor="0xE9EBEFFF" />
            <Poster id="ring" translation="[920, 500]" width="80" height="80" uri="pkg:/images/ui/buffering-arc.png" blendColor="0x38BDF8FF" scaleRotateCenter="[40, 40]" />
            <Group id="bufferingNote" visible="false">
                <Poster id="bufferingBack" uri="pkg:/images/ui/r12.9.png" blendColor="0x0B0D1099" height="56" />
                <Label id="bufferingLabel" height="56" horizAlign="center" vertAlign="center" color="0xE9EBEFFF" />
            </Group>
        </Group>
        <Animation id="fadeIn" duration="0.15" easeFunction="linear">
            <FloatFieldInterpolator key="[0, 1]" keyValue="[0, 1]" fieldToInterp="controls.opacity" />
        </Animation>
        <Animation id="fadeOut" duration="0.25" easeFunction="linear">
            <FloatFieldInterpolator key="[0, 1]" keyValue="[1, 0]" fieldToInterp="controls.opacity" />
        </Animation>
        <Animation id="spin" duration="1" repeat="true" easeFunction="linear">
            <FloatFieldInterpolator key="[0, 1]" keyValue="[0, -6.2832]" fieldToInterp="ring.rotation" />
        </Animation>
        <!-- The clock, on the minute while the controls show. -->
        <Timer id="clockTimer" repeat="true" duration="15" />
    </children>
</component>
