<?xml version="1.0" encoding="utf-8"?>
<!-- A request in the requests' list: its poster, its title and what it is
     ("2008 · Show · Seasons 1–2"), its stage's pill with the download's
     progress, who asked and when, and a line of what to know (why it isn't
     sent, why it was declined, a manager's note). A mark between the poster
     and the title while it has news the account hasn't seen. -->
<component name="RequestRow" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContent" />
        <field id="itemHasFocus" type="boolean" onChange="onFocus" />
        <field id="listHasFocus" type="boolean" value="true" onChange="onFocus" />
        <field id="width" type="float" onChange="onWidth" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/items/RequestRow.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Paint.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Colors.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Type.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/I18n.brs" />
    <children>
        <Rectangle id="background" width="1728" height="176" color="0x12151AFF" />
        <Rectangle id="bar" width="6" height="176" color="0x38BDF8FF" visible="false" />
        <Rectangle id="frame" translation="[28, 10]" width="104" height="156" color="0x191D24FF" />
        <Poster id="poster" translation="[28, 10]" width="104" height="156" loadWidth="104" loadHeight="156" loadDisplayMode="scaleToZoom" />
        <Rectangle id="unseen" translation="[140, 26]" width="10" height="10" color="0x38BDF8FF" visible="false" />
        <Label id="title" translation="[160, 10]" width="920" color="0xE9EBEFFF">
            <Font role="font" uri="pkg:/fonts/roboto-700.ttf" size="30" />
        </Label>
        <Label id="subtitle" translation="[160, 56]" width="920" color="0xA1A9B6FF" font="font:SmallestSystemFont" />
        <Label id="who" translation="[1100, 16]" width="600" horizAlign="right" color="0xA1A9B6FF" font="font:SmallestSystemFont" />
        <StagePill id="stage" translation="[160, 94]" />
        <Label id="line" translation="[160, 144]" width="1540" color="0xA1A9B6FF" font="font:TinySystemFont" />
    </children>
</component>
