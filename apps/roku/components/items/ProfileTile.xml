<?xml version="1.0" encoding="utf-8"?>
<!-- A profile in "Who's watching?": its picture (or its initial on its
     colour), its name, and whether it takes a PIN or its password. -->
<component name="ProfileTile" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContent" />
        <field id="itemHasFocus" type="boolean" onChange="onFocus" />
        <field id="gridHasFocus" type="boolean" value="true" onChange="onFocus" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/items/ProfileTile.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/I18n.brs" />
    <children>
        <Rectangle id="ring" translation="[-8, -8]" width="236" height="236" color="0xEBEBEBFF" visible="false" />
        <Rectangle id="face" width="220" height="220" color="0x2E3440FF" />
        <Label id="initial" width="220" height="220" horizAlign="center" vertAlign="center" color="0xEBEBEBFF" font="font:ExtraLargeBoldSystemFont" />
        <Poster id="picture" width="220" height="220" loadWidth="220" loadHeight="220" loadDisplayMode="scaleToZoom" />
        <Label id="name" translation="[-20, 240]" width="260" horizAlign="center" color="0xA1A9B6FF" font="font:MediumSystemFont" />
        <Label id="needs" translation="[-20, 290]" width="260" horizAlign="center" color="0x8B95A5FF" font="font:SmallestSystemFont" />
    </children>
</component>
