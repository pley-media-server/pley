<?xml version="1.0" encoding="utf-8"?>
<!-- A profile in "Who's watching?": its picture (or its initial on its
     color), its name, and whether it takes a PIN or its password. -->
<component name="ProfileTile" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContent" />
        <field id="itemHasFocus" type="boolean" onChange="onFocus" />
        <field id="gridHasFocus" type="boolean" value="true" onChange="onFocus" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/items/ProfileTile.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Type.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/I18n.brs" />
    <children>
        <!-- A circle, as the rail's profile: focused, the accent's ring
             around it, inside the tile (a grid cuts off what its items
             draw outside them). -->
        <Poster id="ring" width="244" height="244" uri="pkg:/images/ui/ring-face.png" visible="false" />
        <Poster id="face" translation="[12, 12]" width="220" height="220" uri="pkg:/images/ui/face.png" blendColor="0x2E3440FF" />
        <Label id="initial" translation="[12, 12]" width="220" height="220" horizAlign="center" vertAlign="center" color="0xEBEBEBFF" font="font:ExtraLargeBoldSystemFont" />
        <MaskGroup translation="[12, 12]" maskUri="pkg:/images/ui/face.png" maskSize="[220, 220]">
            <Poster id="picture" width="220" height="220" loadWidth="220" loadHeight="220" loadDisplayMode="scaleToZoom" />
        </MaskGroup>
        <Label id="name" translation="[-8, 252]" width="260" horizAlign="center" color="0xA1A9B6FF" font="font:MediumSystemFont" />
        <Label id="needs" translation="[-8, 302]" width="260" horizAlign="center" color="0x8B95A5FF" font="font:SmallestSystemFont" />
    </children>
</component>
