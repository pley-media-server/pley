<?xml version="1.0" encoding="utf-8"?>
<!-- An entry of Home's rail, as the Android TV app's (TvRail): its icon in
     the column the collapsed rail keeps (the current page's in fg with a
     8 by 40 accent mark at the left edge, the others muted), its name
     beside it once the rail opens, and a number after it (the requests
     waiting, news), red while some failed. The profile's entry at the top
     is its initial in a circle. Focused, the accent behind it, square as
     menus are, the icon and the name dark on it. -->
<component name="RailRow" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContent" />
        <field id="itemHasFocus" type="boolean" onChange="onFocus" />
        <field id="listHasFocus" type="boolean" value="true" onChange="onFocus" />
        <field id="width" type="float" onChange="onWidth" />
        <!-- 80, or less when the rail's entries wouldn't all fit
             (Rail.brs): what is on it stays in its middle. -->
        <field id="height" type="float" onChange="onHeight" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/items/RailRow.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Paint.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Colors.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/I18n.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Type.brs" />
    <children>
        <Poster id="pill" uri="pkg:/images/ui/square.9.png" blendColor="0x38BDF8FF" height="80" width="80" translation="[32, 0]" visible="false" />
        <Rectangle id="mark" translation="[0, 20]" width="8" height="40" color="0x38BDF8FF" visible="false" />
        <Poster id="icon" translation="[52, 20]" width="40" height="40" blendColor="0xA1A9B6FF" />
        <Poster id="avatar" translation="[44, 12]" width="56" height="56" uri="pkg:/images/ui/circle.png" blendColor="0x222731FF" visible="false" />
        <Label id="initial" translation="[44, 12]" width="56" height="56" horizAlign="center" vertAlign="center" color="0xE9EBEFFF" visible="false" />
        <Label id="name" translation="[124, 0]" width="300" height="80" vertAlign="center" maxLines="1" color="0xE9EBEFFF" opacity="0" />
        <Poster id="countBack" uri="pkg:/images/ui/r12.9.png" height="40" translation="[0, 20]" visible="false" />
        <Label id="count" height="40" translation="[0, 20]" horizAlign="center" vertAlign="center" color="0x091925FF" visible="false" />
    </children>
</component>
