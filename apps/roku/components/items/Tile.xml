<?xml version="1.0" encoding="utf-8"?>
<!-- A title in a RowList row or a MarkupGrid, as the Android TV app's tile
     (TvTile, ArtworkTile): its artwork in a well with round corners (Roku
     OS 16's Effect; square before), a faint line along its inner edge, how
     far along it is or a tick once watched, a badge (a TMDB title's "In
     library", "Requested"), a library's quality badges ("4K", "DV") at the
     artwork's foot, and two lines under it. Focused, it grows to 1.08 with
     the accent's ring around it and its title goes bold; the list's
     focusPercent drives the growth and the ring, so a move animates with no
     BrightScript a frame. The well and the artwork grow by their size: a
     scale undoes the Effect's corners. 24 px at the artwork's left and 30
     over it leave the list room for the growth and the ring. -->
<component name="Tile" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContent" />
        <field id="width" type="float" onChange="onLayout" />
        <field id="height" type="float" onChange="onLayout" />
        <field id="itemHasFocus" type="boolean" onChange="onFocus" />
        <!-- RowList sets the first two, MarkupGrid the third. -->
        <field id="rowHasFocus" type="boolean" value="true" onChange="onFocus" />
        <field id="rowListHasFocus" type="boolean" value="true" onChange="onFocus" />
        <field id="gridHasFocus" type="boolean" value="true" onChange="onFocus" />
        <field id="focusPercent" type="float" alias="growth.fraction,wellWidth.fraction,wellHeight.fraction,wellPlace.fraction,posterWidth.fraction,posterHeight.fraction,posterPlace.fraction,ringFade.fraction" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/items/Tile.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/I18n.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Type.brs" />
    <children>
        <Group translation="[24, 30]">
            <Rectangle id="well" color="0x262B35FF" />
            <Label id="fallback" color="0xA1A9B6FF" horizAlign="center" vertAlign="center" wrap="true" maxLines="4" />
            <Poster id="poster" loadDisplayMode="scaleToZoom" />
            <!-- What is on the artwork grows with it, as a group. -->
            <Group id="art">
                <Poster id="hairline" uri="pkg:/images/ui/hairline.9.png" />
                <Rectangle id="track" color="0x16191E99" visible="false" />
                <Rectangle id="fill" color="0x38BDF8FF" visible="false" />
                <Poster id="watched" uri="pkg:/images/ui/tick.png" width="40" height="40" visible="false" />
                <Poster id="badgeBack" uri="pkg:/images/ui/r4.9.png" height="36" visible="false" />
                <Label id="badge" height="36" vertAlign="center" color="0x16191EFF" visible="false" />
                <!-- Two quality badges at most: "4K" and the dynamic range,
                     dark under light words, as the other apps draw them on
                     pictures. -->
                <Poster id="qualityBack0" uri="pkg:/images/ui/r4.9.png" blendColor="0x0B0D10CC" height="36" visible="false" />
                <Label id="quality0" height="36" vertAlign="center" color="0xEBEBEBFF" visible="false" />
                <Poster id="qualityBack1" uri="pkg:/images/ui/r4.9.png" blendColor="0x0B0D10CC" height="36" visible="false" />
                <Label id="quality1" height="36" vertAlign="center" color="0xEBEBEBFF" visible="false" />
                <!-- The accent's ring, 12 px out from the well all round. -->
                <Poster id="ring" uri="pkg:/images/ui/ring.9.png" opacity="0" />
            </Group>
            <Label id="title" color="0xEBEBEBFF" maxLines="1" />
            <Label id="subtitle" color="0xA1A9B6FF" maxLines="1" />
        </Group>
        <Vector2DFieldInterpolator id="growth" key="[0, 1]" keyValue="[[1, 1], [1.08, 1.08]]" fieldToInterp="art.scale" />
        <!-- The well's and the artwork's sizes and places, grown 4 % each
             way from the middle (onLayout fills them in). -->
        <FloatFieldInterpolator id="wellWidth" key="[0, 1]" keyValue="[0, 0]" fieldToInterp="well.width" />
        <FloatFieldInterpolator id="wellHeight" key="[0, 1]" keyValue="[0, 0]" fieldToInterp="well.height" />
        <Vector2DFieldInterpolator id="wellPlace" key="[0, 1]" keyValue="[[0, 0], [0, 0]]" fieldToInterp="well.translation" />
        <FloatFieldInterpolator id="posterWidth" key="[0, 1]" keyValue="[0, 0]" fieldToInterp="poster.width" />
        <FloatFieldInterpolator id="posterHeight" key="[0, 1]" keyValue="[0, 0]" fieldToInterp="poster.height" />
        <Vector2DFieldInterpolator id="posterPlace" key="[0, 1]" keyValue="[[0, 0], [0, 0]]" fieldToInterp="poster.translation" />
        <FloatFieldInterpolator id="ringFade" key="[0, 1]" keyValue="[0, 1]" fieldToInterp="ring.opacity" />
    </children>
</component>
