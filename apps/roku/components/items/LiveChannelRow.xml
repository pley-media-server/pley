<?xml version="1.0" encoding="utf-8"?>
<!-- A channel in the player's channel list (a MarkupList): its number,
     logo, name, what's on with how far along, and a star for a favorite;
     the channel playing in the accent. -->
<component name="LiveChannelRow" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContent" />
        <field id="width" type="float" onChange="onLayout" />
        <field id="height" type="float" onChange="onLayout" />
        <field id="itemHasFocus" type="boolean" onChange="onFocus" />
        <field id="listHasFocus" type="boolean" value="true" onChange="onFocus" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/items/LiveChannelRow.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Paint.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Colors.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Type.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/I18n.brs" />
    <children>
        <Rectangle id="back" color="0x0B0D1000" />
        <Rectangle id="mark" color="0x38BDF8FF" width="6" visible="false" />
        <Label id="number" width="72" horizAlign="right" vertAlign="center" color="0x7E8795FF">
            <Font role="font" uri="pkg:/fonts/roboto-700.ttf" size="26" />
        </Label>
        <Rectangle id="plate" color="0x222731FF" width="112" height="64" />
        <Label id="initials" width="112" height="64" horizAlign="center" vertAlign="center" color="0xA1A9B6FF">
            <Font role="font" uri="pkg:/fonts/roboto-700.ttf" size="26" />
        </Label>
        <Poster id="logo" loadDisplayMode="scaleToFit" width="96" height="52" loadWidth="96" loadHeight="52" />
        <Label id="title" color="0xE9EBEFFF">
            <Font role="font" uri="pkg:/fonts/roboto-700.ttf" size="26" />
        </Label>
        <Label id="line" color="0xA1A9B6FF" font="font:TinySystemFont" />
        <Rectangle id="track" color="0x222731FF" height="4" />
        <Rectangle id="fill" color="0x38BDF8FF" height="4" />
        <Label id="star" text="★" width="40" horizAlign="center" vertAlign="center" color="0x38BDF8FF" visible="false">
            <Font role="font" uri="pkg:/fonts/roboto-700.ttf" size="26" />
        </Label>
    </children>
</component>
