<?xml version="1.0" encoding="utf-8"?>
<!-- A row of Settings, as the Android TV app's (TvSettingRow): its icon,
     its label and under it the current value, muted; at the right a
     chevron for a row that opens something, or a switch. Focused, it fills
     with the accent and what is on it turns dark. Sign out reads red. A
     category of Settings (isCategory) has its chevron while it is the one
     shown, and a muted fill while the focus is on its rows (held). -->
<component name="SettingRow" extends="Group">
    <interface>
        <!-- title, description (the value), icon, trailing ("chevron",
             "switch" or ""), checked (the switch's), danger, isCategory
             (not category, a ContentNode field of its own), held. -->
        <field id="itemContent" type="node" onChange="onContent" />
        <field id="itemHasFocus" type="boolean" onChange="onFocus" />
        <field id="listHasFocus" type="boolean" onChange="onFocus" />
        <field id="width" type="float" onChange="onLayout" />
        <field id="height" type="float" onChange="onLayout" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/items/SettingRow.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/I18n.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Type.brs" />
    <children>
        <Poster id="pill" uri="pkg:/images/ui/square.9.png" blendColor="0x38BDF8FF" translation="[0, 4]" visible="false" />
        <Poster id="icon" translation="[28, 0]" width="40" height="40" blendColor="0xA1A9B6FF" />
        <Label id="label" translation="[92, 0]" maxLines="1" color="0xEBEBEBFF" />
        <Label id="value" translation="[92, 0]" maxLines="1" color="0xA1A9B6FF" />
        <Poster id="chevron" width="40" height="40" uri="pkg:/images/ui/icon-chevron-right-40.png" blendColor="0x8B95A5FF" visible="false" />
        <Group id="switch" visible="false">
            <Poster id="track" width="80" height="44" uri="pkg:/images/ui/switch.png" />
            <Poster id="thumb" translation="[6, 6]" width="32" height="32" uri="pkg:/images/ui/circle.png" />
        </Group>
    </children>
</component>
