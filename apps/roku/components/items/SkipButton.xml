<?xml version="1.0" encoding="utf-8"?>
<!-- Skip Intro / Skip Credits over the video, with the focus while shown:
     OK presses it; play, fast forward and rewind go to the player, which
     acts on the video; Back and the rest go on as without the button. -->
<component name="SkipButton" extends="Group">
    <interface>
        <field id="text" type="string" onChange="onText" />
        <field id="pressed" type="boolean" alwaysNotify="true" />
        <!-- "play", "fastforward", "rewind" or "replay", as pressed -->
        <field id="playKey" type="string" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/items/SkipButton.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/I18n.brs" />
    <children>
        <!-- Quiet over the picture: dark and see-through inside a light
             outline, which it always has, holding the focus while it shows. -->
        <Rectangle width="280" height="60" color="0x000000A6" />
        <Rectangle width="280" height="2" color="0xE9EBEFE6" />
        <Rectangle translation="[0, 58]" width="280" height="2" color="0xE9EBEFE6" />
        <Rectangle translation="[0, 2]" width="2" height="56" color="0xE9EBEFE6" />
        <Rectangle translation="[278, 2]" width="2" height="56" color="0xE9EBEFE6" />
        <Label id="label" width="280" height="60" horizAlign="center" vertAlign="center" color="0xE9EBEFFF" font="font:SmallSystemFont" />
    </children>
</component>
