<?xml version="1.0" encoding="utf-8"?>
<!-- An episode in a season's list: its still, how far along it is, its
     number and title, and the start of its summary. -->
<component name="EpisodeRow" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContent" />
        <field id="itemHasFocus" type="boolean" onChange="onFocus" />
        <field id="listHasFocus" type="boolean" value="true" onChange="onFocus" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/items/EpisodeRow.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/I18n.brs" />
    <children>
        <Rectangle id="background" width="1124" height="196" color="0x1E222AFF" />
        <Rectangle id="bar" width="6" height="196" color="0x38BDF8FF" visible="false" />
        <Rectangle id="frame" translation="[16, 14]" width="298" height="168" color="0x262B35FF" />
        <Poster id="thumb" translation="[16, 14]" width="298" height="168" loadWidth="298" loadHeight="168" loadDisplayMode="scaleToZoom" />
        <Rectangle id="track" translation="[16, 172]" width="298" height="10" color="0x16191ECC" visible="false" />
        <Rectangle id="fill" translation="[16, 172]" width="0" height="10" color="0x38BDF8FF" visible="false" />
        <Label id="title" translation="[340, 16]" width="760" color="0xEBEBEBFF" font="font:SmallBoldSystemFont" />
        <Label id="subtitle" translation="[340, 60]" width="760" color="0xA1A9B6FF" font="font:SmallestSystemFont" />
        <Label id="summary" translation="[340, 100]" width="760" wrap="true" maxLines="2" color="0xA1A9B6FF" font="font:TinySystemFont" />
    </children>
</component>
