<?xml version="1.0" encoding="utf-8"?>
<!-- A track of Now Playing's Up next: its place and title, its artist and
     album, and how long it is. A TrackRow as wide as the screen. -->
<component name="QueueRow" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContent" />
        <field id="itemHasFocus" type="boolean" onChange="onFocus" />
        <field id="listHasFocus" type="boolean" value="true" onChange="onFocus" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/items/TrackRow.brs" />
    <children>
        <Rectangle id="background" width="1728" height="56" color="0x1E222AFF" />
        <Rectangle id="bar" width="6" height="56" color="0x38BDF8FF" visible="false" />
        <Label id="title" translation="[32, 0]" width="980" height="56" vertAlign="center" color="0xEBEBEBFF" font="font:SmallSystemFont" />
        <Label id="subtitle" translation="[1040, 0]" width="520" height="56" vertAlign="center" color="0xA1A9B6FF" font="font:SmallestSystemFont" />
        <Label id="duration" translation="[1588, 0]" width="108" height="56" horizAlign="right" vertAlign="center" color="0xA1A9B6FF" font="font:SmallestSystemFont" />
    </children>
</component>
