<?xml version="1.0" encoding="utf-8"?>
<!-- A track of Now Playing's Up next, as Android TV's: its place in the
     queue (the playing one a waveform in the accent), its title over its
     artist and album, and how long it is. As wide as the list. -->
<component name="QueueRow" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContent" />
        <field id="itemHasFocus" type="boolean" onChange="onFocus" />
        <field id="listHasFocus" type="boolean" value="true" onChange="onFocus" />
        <field id="width" type="float" onChange="onWidth" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/items/QueueRow.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Type.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/I18n.brs" />
    <children>
        <Rectangle id="background" width="968" height="96" color="0x1E222AFF" visible="false" />
        <Rectangle id="bar" width="6" height="96" color="0x38BDF8FF" visible="false" />
        <Label id="number" translation="[16, 0]" width="64" height="96" horizAlign="center" vertAlign="center" color="0x8B95A5FF" font="font:SmallestSystemFont" />
        <Poster id="playing" translation="[28, 28]" width="40" height="40" uri="pkg:/images/ui/icon-audio-lines-40.png" blendColor="0x38BDF8FF" visible="false" />
        <Label id="title" translation="[112, 14]" width="700" color="0xEBEBEBFF" font="font:SmallSystemFont" />
        <Label id="subtitle" translation="[112, 52]" width="700" color="0xA1A9B6FF" font="font:SmallestSystemFont" />
        <Label id="duration" translation="[820, 0]" width="120" height="96" horizAlign="right" vertAlign="center" color="0xA1A9B6FF" font="font:SmallestSystemFont" />
    </children>
</component>
