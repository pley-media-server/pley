<?xml version="1.0" encoding="utf-8"?>
<!-- A collection: its backdrop, "Collection" with its TMDB, Smart and
     category badges, its title, what it holds (how many titles, the
     library, its order or what its filter keeps) and its summary, Play
     and Shuffle, then its titles' posters. The text is laid out top to
     bottom, leaving out what a collection doesn't have; Down slides the
     page up to the posters. A Home row of several collections of one
     title shows them together, as one: what they hold and the libraries
     they come from, and after Play and Shuffle a button for each
     library's own collection. -->
<component name="CollectionScreen" extends="Group">
    <interface>
        <field id="route" type="string" />
        <field id="params" type="assocarray" />
        <field id="navigate" type="assocarray" alwaysNotify="true" />
        <field id="active" type="boolean" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/screens/CollectionScreen.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/I18n.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Ui.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Titles.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Url.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Http.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nav.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nodes.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Format.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Player.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Content.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Pages.brs" />
    <children>
        <!-- The backdrop over the whole screen, as a title's page has it:
             under the scrim from the left (the text's side) and a fade to
             the rows; the backdrop alone, faint, while they have the
             focus (uiDimBackdrop). -->
        <Backdrop id="backdrop" />
        <Poster id="scrim" width="1600" height="1080" uri="pkg:/images/ui/scrim-left.png" blendColor="0x0B0D10FF" />
        <Poster id="fade" translation="[0, 540]" width="1920" height="540" uri="pkg:/images/ui/fade-down.png" blendColor="0x0B0D10FF" />
        <Group id="page">
            <LayoutGroup id="column" translation="[192, 80]" layoutDirection="vert" itemSpacings="[40]" visible="false">
                <!-- Only the labels with text stay in it (layoutText). -->
                <LayoutGroup id="text" layoutDirection="vert">
                    <!-- "Collection", then its badges beside it (showBadges). -->
                    <Group id="eyebrow">
                        <!-- Android TV's layers before the word, and the badges
                             outlined as a title's rating is. -->
                        <Poster translation="[0, 2]" width="36" height="36" uri="pkg:/images/ui/icon-layers-40.png" blendColor="0xA1A9B6FF" />
                        <Label id="kindLabel" translation="[48, 0]" height="40" vertAlign="center" color="0xA1A9B6FF" font="font:SmallSystemFont" />
                        <Group id="tmdb" visible="false">
                            <Poster id="tmdbBack" height="40" uri="pkg:/images/ui/edge4.9.png" blendColor="0x7E8795FF" />
                            <Label id="tmdbText" translation="[14, 0]" height="40" vertAlign="center" text="TMDB" color="0xE9EBEFFF">
                                <Font role="font" uri="pkg:/fonts/roboto-700.ttf" size="26" />
                            </Label>
                        </Group>
                        <Group id="smart" visible="false">
                            <Poster id="smartBack" height="40" uri="pkg:/images/ui/edge4.9.png" blendColor="0x7E8795FF" />
                            <Label id="smartText" translation="[14, 0]" height="40" vertAlign="center" color="0xE9EBEFFF">
                                <Font role="font" uri="pkg:/fonts/roboto-700.ttf" size="26" />
                            </Label>
                        </Group>
                        <!-- Its category, cut short past 560 pixels. -->
                        <Group id="category" visible="false">
                            <Poster id="categoryBack" height="40" uri="pkg:/images/ui/edge4.9.png" blendColor="0x7E8795FF" />
                            <Label id="categoryText" translation="[14, 0]" height="40" vertAlign="center" color="0xE9EBEFFF">
                                <Font role="font" uri="pkg:/fonts/roboto-700.ttf" size="26" />
                            </Label>
                        </Group>
                    </Group>
                    <Label id="heading" width="1020" wrap="true" maxLines="2" color="0xE9EBEFFF" font="font:ExtraLargeBoldSystemFont" />
                    <Label id="facts" width="1020" color="0xA1A9B6FF" font="font:SmallSystemFont" />
                    <Label id="summary" width="1000" wrap="true" maxLines="3" lineSpacing="6" color="0xE9EBEFFF" font="font:SmallerSystemFont" />
                    <Label id="note" width="1020" wrap="true" color="0xA1A9B6FF" font="font:SmallSystemFont" />
                </LayoutGroup>
                <ChipRow id="buttons" look="buttons" pad="64" visible="false" />
            </LayoutGroup>
            <!-- Under the buttons (placeGrid); the page slides up to it. -->
            <QuickGrid id="grid" translation="[168, 720]" itemComponentName="Tile" numColumns="7" numRows="2" itemSize="[216, 414]" itemSpacing="[4, 16]" drawFocusFeedback="false" vertFocusAnimationStyle="floatingFocus" visible="false" />
        </Group>
        <Label id="message" translation="[192, 480]" width="1100" wrap="true" color="0xA1A9B6FF" font="font:MediumSystemFont" />
    </children>
</component>
