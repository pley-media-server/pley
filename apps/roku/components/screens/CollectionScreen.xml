<?xml version="1.0" encoding="utf-8"?>
<!-- A collection: its backdrop, "Collection" with its TMDB or Smart
     badge, its title, what it holds (how many titles, the library, its
     order or what its filter keeps) and its summary, Play and Shuffle,
     then its titles' posters. The text is laid out top to bottom, leaving
     out what a collection doesn't have; Down slides the page up to the
     posters. -->
<component name="CollectionScreen" extends="Group">
    <interface>
        <field id="route" type="string" />
        <field id="params" type="assocarray" />
        <field id="navigate" type="assocarray" alwaysNotify="true" />
        <field id="active" type="boolean" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/screens/CollectionScreen.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/I18n.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Ui.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Titles.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Url.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Http.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nav.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nodes.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Format.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Player.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Content.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Pages.brs" />
    <children>
        <Poster id="backdrop" width="1920" height="1080" loadWidth="640" loadHeight="360" loadDisplayMode="scaleToZoom" opacity="0.4" />
        <Rectangle id="shade" width="1260" height="1080" color="0x16191ED9" />
        <Group id="page">
            <LayoutGroup id="column" translation="[96, 80]" layoutDirection="vert" itemSpacings="[40]" visible="false">
                <!-- Only the labels with text stay in it (layoutText). -->
                <LayoutGroup id="text" layoutDirection="vert">
                    <!-- "Collection", then its badges beside it (showBadges). -->
                    <Group id="eyebrow">
                        <Label id="kindLabel" height="40" vertAlign="center" text="Collection" color="0xA1A9B6FF" font="font:SmallSystemFont" />
                        <Group id="tmdb" visible="false">
                            <Rectangle id="tmdbBack" height="40" color="0x2E3440FF" />
                            <Label id="tmdbText" translation="[14, 0]" height="40" vertAlign="center" text="TMDB" color="0xEBEBEBFF" font="font:SmallestBoldSystemFont" />
                        </Group>
                        <Group id="smart" visible="false">
                            <Rectangle id="smartBack" height="40" color="0x2E3440FF" />
                            <Label id="smartText" translation="[14, 0]" height="40" vertAlign="center" text="Smart" color="0xEBEBEBFF" font="font:SmallestBoldSystemFont" />
                        </Group>
                    </Group>
                    <Label id="heading" width="1100" wrap="true" maxLines="2" color="0xEBEBEBFF" font="font:ExtraLargeBoldSystemFont" />
                    <Label id="facts" width="1100" color="0xA1A9B6FF" font="font:SmallSystemFont" />
                    <Label id="summary" width="1080" wrap="true" maxLines="3" lineSpacing="6" color="0xEBEBEBFF" font="font:SmallerSystemFont" />
                    <Label id="note" width="1100" wrap="true" color="0xA1A9B6FF" font="font:SmallSystemFont" />
                </LayoutGroup>
                <ButtonGroup id="buttons" focusBitmapUri="pkg:/images/button-focus.9.png" focusFootprintBitmapUri="pkg:/images/button-footprint.9.png" textColor="0xEBEBEBFF" focusedTextColor="0x16191EFF" iconUri="" focusedIconUri="" minWidth="560" visible="false" />
            </LayoutGroup>
            <!-- Its top shows under the buttons; the page slides up to it. -->
            <MarkupGrid id="grid" translation="[96, 720]" itemComponentName="Tile" numColumns="7" numRows="2" itemSize="[220, 410]" itemSpacing="[28, 24]" drawFocusFeedback="false" vertFocusAnimationStyle="floatingFocus" visible="false" />
        </Group>
        <Label id="message" translation="[96, 480]" width="1100" wrap="true" color="0xA1A9B6FF" text="Loading…" font="font:MediumSystemFont" />
    </children>
</component>
