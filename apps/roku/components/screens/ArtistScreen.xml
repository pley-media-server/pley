<?xml version="1.0" encoding="utf-8"?>
<!-- An artist: their picture, round, "Artist", their name, albums,
     tracks and genres, their summary, and Play, Shuffle and (while music
     plays) Now playing on the left; their albums on the right, newest
     first. The text is laid out top to bottom, leaving out what an artist
     doesn't have. -->
<component name="ArtistScreen" extends="Group">
    <interface>
        <field id="route" type="string" />
        <field id="params" type="assocarray" />
        <field id="navigate" type="assocarray" alwaysNotify="true" />
        <field id="active" type="boolean" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/screens/ArtistScreen.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Ui.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Titles.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Url.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Http.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nav.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nodes.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Format.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Player.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Content.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Pages.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Music.brs" />
    <children>
        <Poster id="backdrop" width="1920" height="1080" loadWidth="640" loadHeight="360" loadDisplayMode="scaleToZoom" opacity="0.15" />
        <LayoutGroup id="column" translation="[96, 64]" layoutDirection="vert" itemSpacings="[28, 36]">
            <!-- Their initials until the picture comes, or without one. -->
            <MaskGroup maskUri="pkg:/images/round.png" maskSize="[320, 320]">
                <Rectangle width="320" height="320" color="0x262B35FF" />
                <Label id="initials" width="320" height="320" horizAlign="center" vertAlign="center" color="0xEBEBEBCC" font="font:ExtraLargeBoldSystemFont" />
                <Poster id="picture" width="320" height="320" loadWidth="320" loadHeight="320" loadDisplayMode="scaleToZoom" />
            </MaskGroup>
            <!-- Only the labels with text stay in it (layoutText). -->
            <LayoutGroup id="text" layoutDirection="vert">
                <Label id="kindLabel" text="Artist" color="0xA1A9B6FF" font="font:SmallestSystemFont" />
                <Label id="name" width="540" wrap="true" maxLines="2" color="0xEBEBEBFF" font="font:LargeBoldSystemFont" />
                <Label id="line" width="540" wrap="true" maxLines="2" color="0xA1A9B6FF" font="font:SmallestSystemFont" />
                <Label id="summary" width="540" wrap="true" maxLines="2" color="0xEBEBEBD9" font="font:SmallestSystemFont" />
            </LayoutGroup>
            <ButtonGroup id="buttons" focusBitmapUri="pkg:/images/button-focus.9.png" focusFootprintBitmapUri="pkg:/images/button-footprint.9.png" textColor="0xEBEBEBFF" focusedTextColor="0x16191EFF" iconUri="" focusedIconUri="" minWidth="520" maxWidth="540" visible="false" />
        </LayoutGroup>
        <Label id="albumsLabel" translation="[700, 64]" text="Albums" color="0xEBEBEBFF" font="font:MediumBoldSystemFont" visible="false" />
        <MarkupGrid id="albums" translation="[700, 128]" itemComponentName="Tile" numColumns="4" numRows="2" itemSize="[260, 340]" itemSpacing="[28, 40]" drawFocusFeedback="false" vertFocusAnimationStyle="floatingFocus" />
        <Label id="message" translation="[700, 400]" width="1124" wrap="true" horizAlign="center" color="0xA1A9B6FF" text="Loading…" font="font:SmallSystemFont" />
    </children>
</component>
