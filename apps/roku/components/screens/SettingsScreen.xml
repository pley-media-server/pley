<?xml version="1.0" encoding="utf-8"?>
<!-- Settings: the server and the profile this TV uses; the language, the
     profile's audio
     and subtitle defaults and this Roku's quality, chosen in a panel at
     the right, and whether the next episode plays by itself; the watch
     history, switch profile, the profile to always start as, sort the
     libraries, switch server or sign out. Under the app's version, TMDB's
     notice, then where the account is managed on the web; at the right,
     Diagnostics and the open-source licenses. -->
<component name="SettingsScreen" extends="Group">
    <interface>
        <field id="route" type="string" />
        <field id="params" type="assocarray" />
        <field id="navigate" type="assocarray" alwaysNotify="true" />
        <field id="active" type="boolean" alwaysNotify="true" />
        <!-- The language shown changed: the screen draws its words again. -->
        <field id="language" type="string" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/screens/SettingsScreen.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/I18n.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Ui.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Url.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Http.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nav.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nodes.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Format.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/SubtitleSync.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Tracks.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/AutoQuality.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Player.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Auth.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Profiles.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Type.brs" />
    <children>
        <Label id="title" translation="[192, 56]" color="0xEBEBEBFF" font="font:ExtraLargeBoldSystemFont" />
        <!-- The rows, as the Android TV app's: Language, the profile's
             defaults, this Roku's quality and next episode, Watch history,
             Switch profile, Always start as, Sort libraries, Diagnostics,
             the licenses, Switch server and Sign out; nine in view. -->
        <MarkupList id="rows" translation="[168, 150]" itemComponentName="SettingRow" itemSize="[792, 96]" numRows="9" drawFocusFeedback="false" vertFocusAnimationStyle="floatingFocus" />
        <!-- At the right: the server, the profile, this Roku and the app,
             where the account is managed (Roku has no QR code of its own,
             so the address alone), what a choice said, and TMDB's credit
             for Discover's titles and pictures. -->
        <Label id="serverLabel" translation="[1056, 150]" color="0x8B95A5FF" font="font:SmallestSystemFont" />
        <Label id="server" translation="[1056, 184]" width="768" color="0xEBEBEBFF" font="font:MediumSystemFont" />
        <Label id="profileLabel" translation="[1056, 250]" color="0x8B95A5FF" font="font:SmallestSystemFont" />
        <Label id="profile" translation="[1056, 284]" width="768" color="0xEBEBEBFF" text="…" font="font:MediumSystemFont" />
        <Label id="deviceLabel" translation="[1056, 350]" color="0x8B95A5FF" font="font:SmallestSystemFont" />
        <Label id="device" translation="[1056, 384]" width="768" color="0xEBEBEBFF" font="font:MediumSystemFont" />
        <Label id="appLabel" translation="[1056, 450]" color="0x8B95A5FF" font="font:SmallestSystemFont" />
        <Label id="version" translation="[1056, 484]" width="768" color="0xEBEBEBFF" font="font:MediumSystemFont" />
        <Label id="webLabel" translation="[1056, 566]" color="0x8B95A5FF" font="font:SmallestSystemFont" />
        <Label id="web" translation="[1056, 600]" width="768" color="0x7DD3FCFF" font="font:MediumSystemFont" />
        <Label id="webHint" translation="[1056, 652]" width="768" wrap="true" maxLines="3" color="0x8B95A5FF" font="font:SmallestSystemFont" />
        <Label id="message" translation="[1056, 790]" width="768" wrap="true" maxLines="4" color="0xA1A9B6FF" font="font:SmallSystemFont" />
        <Label id="tmdb" translation="[1056, 960]" width="768" wrap="true" maxLines="2" color="0x8B95A5FF" font="font:SmallestSystemFont" />
        <!-- The choices of one row in a side panel, as the Android TV app's
             (TvChoicePanel) and the player's: 720 wide from the right edge
             over the page dimmed, the current choice checked, the focused
             one's hint at its foot. -->
        <Group id="panel" visible="false">
            <Rectangle width="1920" height="1080" color="0x16191E80" />
            <Poster translation="[1200, 0]" width="720" height="1080" uri="pkg:/images/ui/panel.9.png" blendColor="0x1E222AFA" />
            <Label id="panelTitle" translation="[1256, 72]" width="608" maxLines="1" color="0xEBEBEBFF" />
            <MarkupList id="choices" translation="[1256, 152]" itemComponentName="PanelRow" itemSize="[608, 88]" itemSpacing="[0, 4]" numRows="8" drawFocusFeedback="false" vertFocusAnimationStyle="floatingFocus" />
            <Label id="panelHint" translation="[1256, 912]" width="608" wrap="true" maxLines="3" color="0xA1A9B6FF" />
        </Group>
    </children>
</component>
