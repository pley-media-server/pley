<?xml version="1.0" encoding="utf-8"?>
<!-- Settings: the server and the profile this TV uses; the language, the
     profile's audio
     and subtitle defaults and this Roku's quality, chosen in a panel at
     the right, and whether the next episode plays by itself; the watch
     history, switch profile, the profile to always start as, sort the
     libraries, switch server or sign out. Under the app's version, TMDB's
     notice, then where the account is managed on the web; at the right,
     Diagnostics and the open-source licences. -->
<component name="SettingsScreen" extends="Group">
    <interface>
        <field id="route" type="string" />
        <field id="params" type="assocarray" />
        <field id="navigate" type="assocarray" alwaysNotify="true" />
        <field id="active" type="boolean" alwaysNotify="true" />
        <!-- The language shown changed: the screen draws its words again. -->
        <field id="language" type="string" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/screens/SettingsScreen.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/I18n.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Ui.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Url.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Http.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nav.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nodes.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Format.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/SubtitleSync.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Tracks.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/AutoQuality.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Player.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Auth.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Profiles.brs" />
    <children>
        <Label id="title" translation="[96, 56]" color="0xEBEBEBFF" font="font:ExtraLargeBoldSystemFont" />
        <Label id="serverLabel" translation="[96, 150]" color="0x8B95A5FF" font="font:SmallestSystemFont" />
        <Label id="server" translation="[96, 186]" width="840" color="0xEBEBEBFF" font="font:MediumSystemFont" />
        <Label id="profileLabel" translation="[96, 250]" color="0x8B95A5FF" font="font:SmallestSystemFont" />
        <Label id="profile" translation="[96, 286]" width="840" color="0xEBEBEBFF" text="…" font="font:MediumSystemFont" />
        <Label id="deviceLabel" translation="[1000, 150]" color="0x8B95A5FF" font="font:SmallestSystemFont" />
        <Label id="device" translation="[1000, 186]" width="824" color="0xEBEBEBFF" font="font:MediumSystemFont" />
        <Label id="appLabel" translation="[1000, 250]" color="0x8B95A5FF" font="font:SmallestSystemFont" />
        <Label id="version" translation="[1000, 286]" width="824" color="0xEBEBEBFF" font="font:MediumSystemFont" />
        <!-- Discover's titles and pictures come from TMDB. -->
        <Label id="tmdb" translation="[1000, 342]" width="824" wrap="true" maxLines="2" color="0x8B95A5FF" font="font:SmallestSystemFont" />
        <!-- Twelve rows at most (Subtitle language and Always start as
             among them): high enough that the last stays clear of the
             screen's edge. -->
        <ButtonGroup id="buttons" focusBitmapUri="pkg:/images/button-focus.9.png" focusFootprintBitmapUri="pkg:/images/button-footprint.9.png" textColor="0xEBEBEBFF" focusedTextColor="0x16191EFF" iconUri="" focusedIconUri="" translation="[96, 340]" minWidth="840" maxWidth="840" />
        <!-- What the other TVs' "Manage your account on the web" says: Roku
             has no QR code of its own, so the address alone. -->
        <Label id="webLabel" translation="[1000, 460]" color="0x8B95A5FF" font="font:SmallestSystemFont" />
        <Label id="web" translation="[1000, 496]" width="824" color="0x7DD3FCFF" font="font:MediumSystemFont" />
        <Label id="webHint" translation="[1000, 552]" width="824" wrap="true" maxLines="3" color="0x8B95A5FF" font="font:SmallestSystemFont" />
        <Label id="message" translation="[1000, 650]" width="824" wrap="true" maxLines="4" color="0xA1A9B6FF" font="font:SmallSystemFont" />
        <ButtonGroup id="about" focusBitmapUri="pkg:/images/button-focus.9.png" focusFootprintBitmapUri="pkg:/images/button-footprint.9.png" textColor="0xEBEBEBFF" focusedTextColor="0x16191EFF" iconUri="" focusedIconUri="" translation="[1000, 850]" minWidth="600" maxWidth="824" />
        <!-- The choices of one row, over the right half. -->
        <Group id="panel" visible="false">
            <Rectangle translation="[1000, 0]" width="920" height="1080" color="0x1E222AFF" />
            <Label id="panelTitle" translation="[1056, 56]" width="808" color="0xEBEBEBFF" font="font:LargeBoldSystemFont" />
            <RadioButtonList id="choices" translation="[1056, 150]" itemSize="[808, 64]" numRows="11" color="0xEBEBEBFF" focusedColor="0x16191EFF" focusBitmapBlendColor="0x38BDF8FF" vertFocusAnimationStyle="floatingFocus" font="font:MediumSystemFont" focusedFont="font:MediumBoldSystemFont" />
            <Label id="panelHint" translation="[1056, 900]" width="808" wrap="true" maxLines="3" color="0xA1A9B6FF" font="font:SmallSystemFont" />
        </Group>
    </children>
</component>
