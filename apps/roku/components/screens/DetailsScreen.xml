<?xml version="1.0" encoding="utf-8"?>
<!-- A movie, an episode or a show: its backdrop and poster, what it is, and
     its buttons (Resume / Play from start, a show's next episode and its
     episodes, Mark as watched, Audio and subtitles, My List, More…). Audio
     and subtitles and More open a panel over the right of the page: the
     version and tracks to play; the rating, Go to show, Media info, Add to
     playlist. The text is laid out top to bottom, leaving out what a title
     doesn't have. Under it, rows of a show's seasons, cast and crew,
     extras, More Like This and the collections it is part of: Down slides
     the page up to them. Under the poster, how a request for the title
     stands; a show the person may ask more seasons of ends its seasons
     with Request more seasons. -->
<component name="DetailsScreen" extends="Group">
    <interface>
        <field id="route" type="string" />
        <field id="params" type="assocarray" />
        <field id="navigate" type="assocarray" alwaysNotify="true" />
        <field id="active" type="boolean" alwaysNotify="true" />
        <!-- The scene's: what requests let the profile do. -->
        <field id="requestSummary" type="assocarray" />
        <!-- Set by the scene: requests changed (the title's is asked
             again). -->
        <field id="requestsChanged" type="assocarray" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/screens/DetailsScreen.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Ui.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Titles.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Url.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Http.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nav.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nodes.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Format.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Player.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Content.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Pages.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Requests.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/SubtitleSync.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Tracks.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Details.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Media.brs" />
    <children>
        <Poster id="backdrop" width="1920" height="1080" loadWidth="640" loadHeight="360" loadDisplayMode="scaleToZoom" opacity="0.4" />
        <Rectangle id="shade" width="1260" height="1080" color="0x16191ED9" />
        <Group id="page">
            <Poster id="poster" translation="[1404, 120]" width="420" height="630" loadWidth="420" loadHeight="630" loadDisplayMode="scaleToZoom" />
            <!-- The title's request, where there is one (GET
                 /api/items/{id}/request). -->
            <StagePill id="stage" translation="[1404, 774]" stacked="true" maxWidth="420" visible="false" />
            <Label id="stageLine" translation="[1404, 852]" width="420" wrap="true" maxLines="3" color="0xA1A9B6FF" font="font:SmallestSystemFont" visible="false" />
            <LayoutGroup id="column" translation="[96, 96]" layoutDirection="vert" itemSpacings="[44]">
                <!-- Only the labels with text stay in it (layoutText). -->
                <LayoutGroup id="text" layoutDirection="vert">
                    <Label id="heading" width="1100" wrap="true" maxLines="2" color="0xEBEBEBFF" font="font:ExtraLargeBoldSystemFont" />
                    <Label id="line" width="1100" color="0xA1A9B6FF" font="font:SmallSystemFont" />
                    <Label id="genres" width="1100" color="0x8B95A5FF" font="font:SmallestSystemFont" />
                    <Label id="tagline" width="1100" maxLines="1" color="0xEBEBEBFF" font="font:SmallerBoldSystemFont" />
                    <Label id="summary" width="1080" wrap="true" maxLines="4" lineSpacing="6" color="0xEBEBEBFF" font="font:SmallerSystemFont" />
                    <Label id="note" width="1100" wrap="true" color="0xA1A9B6FF" font="font:SmallSystemFont" />
                </LayoutGroup>
                <ButtonGroup id="buttons" focusBitmapUri="pkg:/images/button-focus.9.png" focusFootprintBitmapUri="pkg:/images/button-footprint.9.png" textColor="0xEBEBEBFF" focusedTextColor="0x16191EFF" iconUri="" focusedIconUri="" minWidth="560" visible="false" />
            </LayoutGroup>
            <!-- Its top shows under the buttons; the page slides up to it. -->
            <RowList id="rows" translation="[96, 940]" itemComponentName="Tile" itemSize="[1728, 470]" numRows="2" itemSpacing="[0, 28]" rowItemSpacing="[[28, 0]]" showRowLabel="[true]" rowLabelOffset="[[0, 12]]" rowLabelColor="0xEBEBEBFF" drawFocusFeedback="false" rowFocusAnimationStyle="floatingFocus" vertFocusAnimationStyle="floatingFocus" rowLabelFont="font:MediumBoldSystemFont" visible="false" />
        </Group>
        <Label id="message" translation="[96, 480]" width="1100" wrap="true" color="0xA1A9B6FF" text="Loading…" font="font:MediumSystemFont" />
        <!-- A menu (Audio and subtitles, More), or the choices of one of its
             entries. It leaves the buttons in view, and is wider than
             Settings' for a version's long line. -->
        <Group id="panel" visible="false">
            <Rectangle translation="[720, 0]" width="1200" height="1080" color="0x1E222AFF" />
            <Label id="panelTitle" translation="[776, 56]" width="1088" color="0xEBEBEBFF" font="font:LargeBoldSystemFont" />
            <LabelList id="menu" translation="[776, 150]" itemSize="[1088, 64]" numRows="11" color="0xEBEBEBFF" focusedColor="0x16191EFF" focusBitmapBlendColor="0x38BDF8FF" vertFocusAnimationStyle="floatingFocus" font="font:MediumSystemFont" focusedFont="font:MediumBoldSystemFont" />
            <RadioButtonList id="choices" translation="[776, 150]" itemSize="[1088, 64]" numRows="11" color="0xEBEBEBFF" focusedColor="0x16191EFF" focusBitmapBlendColor="0x38BDF8FF" vertFocusAnimationStyle="floatingFocus" font="font:MediumSystemFont" focusedFont="font:MediumBoldSystemFont" visible="false" />
            <!-- Media info: Up and Down scroll it. -->
            <ScrollableText id="info" translation="[776, 150]" width="1088" height="870" lineSpacing="6" color="0xEBEBEBFF" font="font:SmallSystemFont" visible="false" />
        </Group>
        <!-- The title's request asked again while it downloads. -->
        <Timer id="requestPoll" duration="10" />
    </children>
</component>
