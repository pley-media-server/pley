<?xml version="1.0" encoding="utf-8"?>
<!-- A movie, an episode or a show: its backdrop and poster, what it is, and
     its buttons (Resume / Play from start, a show's next episode and its
     episodes, Mark as watched, Audio and subtitles, My List, Trailer,
     More…). Audio and subtitles and More open a panel over the right of
     the page: the version and tracks to play; the rating, Go to show and
     season, Media info, Details (the whole summary and the title's facts),
     Add to playlist. The text is laid out top to
     bottom, leaving out what a title doesn't have. Under it, rows of a
     show's seasons, cast and crew, extras, More Like This and the
     collections it is part of: Down slides the page up to them. Under the
     poster, how a request for the title stands; a show the person may ask
     more seasons of ends its seasons with Request more seasons. -->
<component name="DetailsScreen" extends="Group">
    <interface>
        <field id="route" type="string" />
        <field id="params" type="assocarray" />
        <field id="navigate" type="assocarray" alwaysNotify="true" />
        <field id="active" type="boolean" alwaysNotify="true" />
        <!-- The scene's: what requests let the profile do. -->
        <field id="requestSummary" type="assocarray" />
        <!-- Set by the scene: requests changed (the title's is asked
             again). -->
        <field id="requestsChanged" type="assocarray" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/screens/DetailsScreen.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/I18n.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Ui.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Type.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Titles.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Url.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Http.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nav.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nodes.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Format.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Player.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Content.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Pages.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Requests.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/SubtitleSync.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Tracks.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Details.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Media.brs" />
    <children>
        <!-- The backdrop over the whole screen, as on Android TV, under the
             scrim from the left (the text's side) and a fade to the
             background at the bottom: no edge cuts it. In the rows, the
             backdrop alone, faint (uiDimBackdrop). -->
        <!-- All but the panel: cut to the panel's left while it shows, so
             what it covers isn't drawn (onPanel). -->
        <Group id="under">
        <Poster id="backdrop" width="1920" height="1080" loadWidth="960" loadHeight="540" loadDisplayMode="scaleToZoom" />
        <Poster id="scrim" width="1600" height="1080" uri="pkg:/images/ui/scrim-left.png" />
        <Poster id="fade" translation="[0, 540]" width="1920" height="540" uri="pkg:/images/ui/fade-down.png" />
        <Group id="page">
            <!-- Only for a title without a backdrop. -->
            <Poster id="poster" translation="[1404, 120]" width="420" height="630" loadWidth="420" loadHeight="630" loadDisplayMode="scaleToZoom" visible="false" />
            <!-- The title's request, where there is one (GET
                 /api/items/{id}/request). -->
            <StagePill id="stage" translation="[1404, 774]" stacked="true" maxWidth="420" visible="false" />
            <Label id="stageLine" translation="[1404, 852]" width="420" wrap="true" maxLines="3" color="0xA1A9B6FF" font="font:SmallestSystemFont" visible="false" />
            <LayoutGroup id="column" translation="[192, 96]" layoutDirection="vert" itemSpacings="[40]">
                <!-- Only the labels with text stay in it (layoutText). -->
                <LayoutGroup id="text" layoutDirection="vert">
                    <Label id="heading" width="1300" wrap="true" maxLines="2" color="0xEBEBEBFF" />
                    <!-- "2025 · 2 h 7 min · [R] · ☆ 7.4 · [4K] [DV]". -->
                    <MetaRow id="line" />
                    <Label id="genres" width="1100" color="0xA1A9B6FF" />
                    <!-- "Directed by … · Starring …". -->
                    <Label id="credits" width="1100" maxLines="1" color="0xA1A9B6FF" />
                    <Label id="tagline" width="1100" maxLines="1" color="0xEBEBEBFF" />
                    <Label id="summary" width="1040" wrap="true" maxLines="3" lineSpacing="6" color="0xEBEBEBFF" />
                    <Label id="note" width="1100" wrap="true" color="0xA1A9B6FF" />
                </LayoutGroup>
                <!-- What plays, a pill; the rest round icons (Android TV's). -->
                <ChipRow id="buttons" look="buttons" pad="64" visible="false" />
            </LayoutGroup>
            <!-- Its top shows under the buttons; the page slides up to it. -->
            <RowList id="rows" translation="[168, 940]" itemComponentName="Tile" itemSize="[1752, 470]" numRows="2" itemSpacing="[0, 28]" rowItemSpacing="[[4, 0]]" showRowLabel="[true]" rowLabelOffset="[[24, 12]]" rowLabelColor="0xEBEBEBFF" drawFocusFeedback="false" rowFocusAnimationStyle="floatingFocus" vertFocusAnimationStyle="floatingFocus" rowLabelFont="font:MediumBoldSystemFont" visible="false" />
        </Group>
        <Label id="message" translation="[192, 480]" width="1100" wrap="true" color="0xA1A9B6FF" />
        </Group>
        <!-- A menu (Audio and subtitles, More), or the choices of one of its
             entries. It leaves the buttons in view, and is wider than
             Settings' for a version's long line. -->
        <Group id="panel" visible="false">
            <Rectangle width="720" height="1080" color="0x16191E80" />
            <Poster translation="[720, 0]" width="1200" height="1080" uri="pkg:/images/ui/panel.9.png" blendColor="0x1E222AFF" />
            <Label id="panelTitle" translation="[776, 72]" width="1088" color="0xEBEBEBFF" />
            <MarkupList id="menu" translation="[776, 150]" itemComponentName="PanelRow" itemSize="[1088, 64]" itemSpacing="[0, 4]" numRows="11" drawFocusFeedback="false" vertFocusAnimationStyle="floatingFocus" />
            <MarkupList id="choices" translation="[776, 150]" itemComponentName="PanelRow" itemSize="[1088, 64]" itemSpacing="[0, 4]" numRows="11" drawFocusFeedback="false" vertFocusAnimationStyle="floatingFocus" visible="false" />
            <!-- Media info: Up and Down scroll it. -->
            <FactSheet id="facts" translation="[776, 150]" width="1064" height="870" visible="false" />
            <!-- Details: Up and Down scroll it. -->
            <ScrollableText id="info" translation="[776, 150]" width="1088" height="870" lineSpacing="6" color="0xEBEBEBFF" font="font:SmallSystemFont" visible="false" />
        </Group>
        <!-- The title's request asked again while it downloads. -->
        <Timer id="requestPoll" duration="10" />
        <!-- Focus resting on a season: its episodes come under the row. -->
        <Timer id="seasonRest" duration="0.3" />
    </children>
</component>
