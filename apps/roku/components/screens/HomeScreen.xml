<?xml version="1.0" encoding="utf-8"?>
<!-- Home, as Android TV's: the rail at the left (the profile, Search,
     Home, Discover and the requests where the server has them, Live TV,
     the libraries, Playlists, Collections, Now Playing, Settings), icons
     alone until it has the focus; then a hero for the first of Continue
     Watching (its backdrop, what it is, Resume or Play, From start, Info
     and the watched mark) over the server's home rows (GET
     /api/hubs/home). In the rows, an info block about the title focus
     rests on takes the hero's place, and the backdrop follows it. -->
<component name="HomeScreen" extends="Group">
    <interface>
        <field id="route" type="string" />
        <field id="params" type="assocarray" />
        <field id="navigate" type="assocarray" alwaysNotify="true" />
        <field id="active" type="boolean" alwaysNotify="true" />
        <!-- Set by the scene when other devices changed what Home shows. -->
        <field id="refresh" type="boolean" alwaysNotify="true" />
        <!-- What requests let the profile do (the scene's): the menu's
             Discover and requests, and their number. -->
        <field id="requestSummary" type="assocarray" onChange="onRequestSummary" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/screens/HomeScreen.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/I18n.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Ui.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Type.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Titles.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Url.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Http.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Auth.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nav.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nodes.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Format.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Player.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Content.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Home.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Pages.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Requests.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Profiles.brs" />
    <children>
        <!-- The backdrop, over the whole screen as on Android TV: the hero's,
             or that of the title focus rests on in the rows, under the
             scrim from the left (the text's side) and a fade to the
             background at the bottom (the rows' side). No edge cuts it. -->
        <Poster id="backdrop" width="1920" height="1080" loadWidth="960" loadHeight="540" loadDisplayMode="scaleToZoom" />
        <Poster id="scrimLeft" width="1600" height="1080" uri="pkg:/images/ui/scrim-left.png" />
        <Poster id="fadeDown" translation="[0, 420]" width="1920" height="660" uri="pkg:/images/ui/fade-down.png" />
        <!-- At rest: the hero, the first row under it. Only the labels with
             text stay in it (layOut). From the page's gutter, x 192. -->
        <LayoutGroup id="hero" translation="[192, 96]" layoutDirection="vert" visible="false">
            <Label id="heroTitle" width="1300" wrap="true" maxLines="2" color="0xEBEBEBFF" />
            <Label id="heroContext" width="1100" maxLines="1" color="0xEBEBEBFF" />
            <MetaRow id="heroMeta" />
            <Label id="heroLeft" width="1100" maxLines="1" color="0xEBEBEBFF" />
            <Label id="heroSummary" width="928" wrap="true" maxLines="3" lineSpacing="6" color="0xEBEBEBFF" />
            <!-- Side by side, Left and Right between them: Resume (or Play)
                 a pill, the rest round icon buttons, as Android TV's. -->
            <ChipRow id="heroButtons" look="buttons" pad="64" />
        </LayoutGroup>
        <!-- In the rows: what the title focus rests on is, over them. -->
        <LayoutGroup id="info" translation="[192, 72]" layoutDirection="vert" visible="false">
            <Label id="infoTitle" width="1300" maxLines="1" color="0xEBEBEBFF" />
            <MetaRow id="infoMeta" />
            <Label id="infoSummary" width="928" wrap="true" maxLines="2" lineSpacing="6" color="0xEBEBEBFF" />
        </LayoutGroup>
        <!-- The focused row's header at y 344 (Android TV's), the others
             scrolling past it; the rows scrolled past are cut at the top,
             under the info block's words. -->
        <RowList id="rows" translation="[168, 620]" itemComponentName="Tile" itemSize="[1752, 470]" numRows="3" itemSpacing="[0, 56]" rowItemSpacing="[[4, 0]]" showRowLabel="[true]" rowLabelOffset="[[24, 28]]" rowLabelColor="0xEBEBEBFF" drawFocusFeedback="false" rowFocusAnimationStyle="floatingFocus" vertFocusAnimationStyle="fixedFocus" clippingRect="[-48, -40, 1776, 1120]" visible="false" />
        <LayoutGroup id="message" translation="[192, 440]" layoutDirection="vert" itemSpacings="[16]">
            <Label id="messageTitle" width="1632" wrap="true" horizAlign="center" color="0xEBEBEBFF" />
            <Label id="messageText" width="1632" wrap="true" horizAlign="center" color="0xA1A9B6FF" />
        </LayoutGroup>
        <!-- The rail, as Android TV's: collapsed, icons in a 144 px column
             over the page's dark; open (it has the focus), a panel of
             surface at 96 % with their names, as wide as they need. -->
        <Group id="railPanel" opacity="0">
            <Rectangle id="railBack" width="520" height="1080" color="0x1E222AFF" />
            <Poster translation="[520, 0]" width="48" height="1080" uri="pkg:/images/ui/shadow.png" />
        </Group>
        <MarkupList id="menu" translation="[0, 144]" itemComponentName="RailRow" itemSize="[520, 80]" itemSpacing="[0, 8]" numRows="10" drawFocusFeedback="false" vertFocusAnimationStyle="floatingFocus" />
        <Animation id="railOpen" duration="0.15" easeFunction="outCubic">
            <FloatFieldInterpolator key="[0, 1]" keyValue="[0, 1]" fieldToInterp="railPanel.opacity" />
        </Animation>
        <Animation id="railClose" duration="0.12" easeFunction="inCubic">
            <FloatFieldInterpolator key="[0, 1]" keyValue="[1, 0]" fieldToInterp="railPanel.opacity" />
        </Animation>
        <!-- Focus resting on a tile: the info block and the backdrop follow. -->
        <Timer id="rest" duration="0.4" />
    </children>
</component>
