<?xml version="1.0" encoding="utf-8"?>
<!-- The live player: a channel's live HLS stream in the Video node (its
     own controls and seek bar off: live is live, with a Live chip), the
     channel's logo with a spinner under it while it tunes, a banner of
     what's on and next, up and down to change channel within the
     category it was opened from, the category's channels at the left
     (Left; another category, or a search, can be listed there), and what
     went wrong when it did (every connection in use, the channel not
     playing). -->
<component name="LivePlayerScreen" extends="Group">
    <interface>
        <field id="route" type="string" />
        <field id="params" type="assocarray" />
        <field id="navigate" type="assocarray" alwaysNotify="true" />
        <field id="active" type="boolean" alwaysNotify="true" />
        <!-- The server's live_taken_over: someone took over a channel's
             connection from this account ({ session_id, channel_id, message }). -->
        <field id="liveTakenOver" type="assocarray" alwaysNotify="true" />
        <!-- The watching's session stopped from another device or by the
             server's administrator ({ session_id, message, by_admin }). -->
        <field id="serverStopped" type="assocarray" alwaysNotify="true" />
        <!-- A command of the user's remote, on another device ({
             session_id, command, position_ms, offset_ms }): next and
             previous change channel. -->
        <field id="playerCommand" type="assocarray" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/screens/LivePlayerScreen.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Paint.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Colors.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/I18n.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Ui.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Url.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Http.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nav.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nodes.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Format.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Live.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Remote.brs" />
    <children>
        <Rectangle width="1920" height="1080" color="0x000000FF" />
        <Video id="video" width="1920" height="1080" enableUI="false" />
        <!-- Waiting for data while it plays. -->
        <BusySpinner id="waiting" translation="[928, 508]" visible="false" />
        <!-- The channel while it tunes (the spinner under its logo), and
             over a channel without pictures (radio). -->
        <Group id="card" visible="false">
            <Rectangle width="1920" height="1080" color="0x000000FF" />
            <Rectangle translation="[780, 280]" width="360" height="180" color="0x191D24FF" />
            <Label id="cardInitials" translation="[780, 280]" width="360" height="180" horizAlign="center" vertAlign="center" wrap="true" maxLines="2" color="0xA1A9B6FF">
                <Font role="font" uri="pkg:/fonts/roboto-700.ttf" size="36" />
            </Label>
            <Poster id="cardLogo" translation="[808, 300]" width="304" height="140" loadWidth="304" loadHeight="140" loadDisplayMode="scaleToFit" />
            <BusySpinner id="tuning" translation="[928, 492]" />
            <Label id="cardTitle" translation="[160, 580]" width="1600" horizAlign="center" color="0xE9EBEFFF" font="font:LargeBoldSystemFont" />
            <Label id="cardLine" translation="[160, 646]" width="1600" horizAlign="center" color="0xA1A9B6FF" font="font:SmallSystemFont" />
        </Group>
        <!-- What's on, when asked for (OK or Right, or the Options key as
             it changes the favorite, whose star shows here). -->
        <Group id="banner" visible="false">
            <Rectangle translation="[0, 680]" width="1920" height="400" color="0x0B0D10E6" />
            <Rectangle translation="[96, 752]" width="240" height="120" color="0x222731FF" />
            <Label id="bannerInitials" translation="[96, 752]" width="240" height="120" horizAlign="center" vertAlign="center" wrap="true" maxLines="2" color="0xA1A9B6FF">
                <Font role="font" uri="pkg:/fonts/roboto-700.ttf" size="26" />
            </Label>
            <Poster id="bannerLogo" translation="[112, 762]" width="208" height="100" loadWidth="208" loadHeight="100" loadDisplayMode="scaleToFit" />
            <Label id="bannerChannel" translation="[384, 744]" width="1100" color="0xA1A9B6FF">
                <Font role="font" uri="pkg:/fonts/roboto-700.ttf" size="30" />
            </Label>
            <Label id="bannerTitle" translation="[384, 782]" width="1100" color="0xE9EBEFFF" font="font:LargeBoldSystemFont" />
            <Label id="bannerMeta" translation="[384, 844]" width="1100" color="0xA1A9B6FF" font="font:SmallestSystemFont" />
            <Rectangle id="bannerTrack" translation="[384, 886]" width="1100" height="6" color="0x222731FF" />
            <Rectangle id="bannerFill" translation="[384, 886]" width="0" height="6" color="0x38BDF8FF" />
            <Label id="bannerNext" translation="[384, 908]" width="1100" color="0x7E8795FF" font="font:SmallestSystemFont" />
            <!-- The Live chip: live is all there is. -->
            <Rectangle translation="[1648, 750]" width="176" height="52" color="0xED6C6DFF" />
            <Label id="liveMark" translation="[1648, 750]" width="176" height="52" horizAlign="center" vertAlign="center" color="0xE9EBEFFF">
                <Font role="font" uri="pkg:/fonts/roboto-700.ttf" size="30" />
            </Label>
            <Label id="star" translation="[1648, 816]" width="176" horizAlign="center" color="0x38BDF8FF">
                <Font role="font" uri="pkg:/fonts/roboto-700.ttf" size="26" />
            </Label>
            <Label id="bannerHint" translation="[96, 968]" width="1728" color="0x7E8795FF" font="font:TinySystemFont" />
        </Group>
        <!-- What went wrong, and what can be done. -->
        <Group id="notice" visible="false">
            <Rectangle width="1920" height="1080" color="0x0B0D10F2" />
            <Label id="noticeTitle" translation="[96, 340]" width="1728" wrap="true" color="0xE9EBEFFF" font="font:ExtraLargeBoldSystemFont" />
            <Label id="noticeText" translation="[96, 430]" width="1500" wrap="true" maxLines="6" color="0xA1A9B6FF" font="font:SmallSystemFont" />
            <PillButtons id="noticeButtons" dark="true" translation="[96, 700]" minWidth="400" />
        </Group>
        <!-- The category's channels, at the left over the video. -->
        <Group id="list" visible="false">
            <Rectangle width="800" height="1080" color="0x0B0D10F2" />
            <Label id="listTitle" translation="[96, 56]" width="664" color="0xE9EBEFFF" font="font:LargeBoldSystemFont" />
            <Label id="listRange" translation="[96, 120]" width="664" color="0x7E8795FF" font="font:SmallestSystemFont" />
            <QuickList id="channelList" translation="[72, 176]" itemComponentName="LiveChannelRow" itemSize="[704, 100]" itemSpacing="[0, 4]" numRows="7" drawFocusFeedback="false" vertFocusAnimationStyle="floatingFocus" />
            <!-- Left in the list: another category to list. -->
            <QuickList id="categoryList" translation="[72, 176]" itemComponentName="LiveRailItem" itemSize="[704, 56]" itemSpacing="[0, 4]" numRows="12" drawFocusFeedback="false" vertFocusAnimationStyle="floatingFocus" visible="false" />
            <!-- Two lines: what the channels do, then the categories and search. -->
            <Label id="listHint" translation="[96, 936]" width="664" wrap="true" maxLines="2" color="0x7E8795FF" font="font:TinySystemFont" />
        </Group>
        <Group id="toast" visible="false">
            <Rectangle translation="[460, 72]" width="1000" height="96" color="0x0B0D10E6" />
            <Label id="toastText" translation="[460, 72]" width="1000" height="96" horizAlign="center" vertAlign="center" color="0xE9EBEFFF" font="font:SmallSystemFont" />
        </Group>
        <!-- The banner goes after a while; up and down wait for more
             presses before tuning; what's on moves on; a channel without
             pictures is looked for. -->
        <Timer id="bannerTimer" duration="5" />
        <Timer id="zapTimer" duration="0.7" />
        <Timer id="clock" duration="15" repeat="true" />
        <Timer id="pictureTimer" duration="3" />
        <Timer id="toastTimer" duration="3" />
        <!-- A stall this long shows the spinner. -->
        <Timer id="stallTimer" duration="0.7" />
        <!-- A channel that failed is tuned again after this (1 s, then 3 s). -->
        <Timer id="retryTimer" duration="1" />
    </children>
</component>
