<?xml version="1.0" encoding="utf-8"?>
<!-- Live TV, by category: the categories down the left
     (Favorites, Recently watched, All channels, then the provider's
     groups, those of a region gathered under it) and the category's
     channels at the right, a page at a time: the Guide (Roku's TimeGrid,
     the program in focus described above it) or Channels (cards with
     what's on now and next). OK on a program on now, or a card, watches
     the channel; the Options key adds it to the favorites or takes it
     out. -->
<component name="LiveTvScreen" extends="Group">
    <interface>
        <field id="route" type="string" />
        <field id="params" type="assocarray" />
        <field id="navigate" type="assocarray" alwaysNotify="true" />
        <field id="active" type="boolean" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/screens/LiveTvScreen.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/I18n.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Ui.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Url.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Http.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nav.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nodes.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Format.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Live.brs" />
    <children>
        <!-- The categories, on the page's dark as Android TV's. -->
        <Label id="title" translation="[192, 54]" width="396" color="0xEBEBEBFF" font="font:ExtraLargeBoldSystemFont" />
        <ChipRow id="tabs" translation="[192, 132]" />
        <!-- Search, pinned above the categories: it never scrolls away. -->
        <QuickList id="searchRow" translation="[168, 224]" itemComponentName="LiveRailItem" itemSize="[420, 56]" numRows="1" drawFocusFeedback="false" />
        <Rectangle translation="[192, 286]" width="372" height="2" color="0x2E3440FF" />
        <QuickList id="rail" translation="[168, 296]" itemComponentName="LiveRailItem" itemSize="[420, 56]" itemSpacing="[0, 4]" numRows="12" drawFocusFeedback="false" vertFocusAnimationStyle="floatingFocus" />
        <!-- The category's channels. -->
        <Label id="category" translation="[624, 54]" width="1200" color="0xEBEBEBFF" font="font:LargeBoldSystemFont" />
        <Label id="count" translation="[624, 112]" width="1200" color="0xA1A9B6FF" font="font:SmallestSystemFont" />
        <!-- The program in focus, above the guide. -->
        <Group id="info" translation="[624, 160]" visible="false">
            <Rectangle translation="[984, 0]" width="216" height="108" color="0x262B35FF" />
            <Poster id="infoLogo" translation="[992, 6]" width="200" height="96" loadWidth="200" loadHeight="96" loadDisplayMode="scaleToFit" />
            <Label id="infoChannel" width="1020" color="0x8B95A5FF" font="font:SmallestBoldSystemFont" />
            <Label id="infoTitle" translation="[0, 30]" width="940" color="0xEBEBEBFF" font="font:LargeBoldSystemFont" />
            <Label id="infoMeta" translation="[0, 86]" width="940" color="0xA1A9B6FF" font="font:SmallestSystemFont" />
            <Label id="infoText" translation="[0, 120]" width="1200" wrap="true" maxLines="1" lineSpacing="2" color="0xA1A9B6FF" font="font:SmallestSystemFont" />
        </Group>
        <!-- Rewind, fast forward and Replay are the screen's (Replay opens
             Search): it pages the guide through time itself. Cut at the
             right margin (x 1824), as the pages' content is: a TimeGrid
             runs to the screen's edge. -->
        <Group clippingRect="[0, 0, 1824, 1080]">
        <TimeGrid id="guide" translation="[624, 376]" numRows="6" duration="7200" maxDays="2" channelInfoWidth="260" infoGridGap="8" ignoreTrickPlayKeys="true"
            focusBitmapUri="pkg:/images/ui/square-accent.9.png" programBackgroundBitmapUri="pkg:/images/guide-cell.9.png"
            channelInfoBackgroundBitmapUri="pkg:/images/guide-cell.9.png" channelInfoTextColor="0xEBEBEBFF" channelInfoFont="font:SmallestBoldSystemFont"
            programTitleColor="0xEBEBEBFF" programTitleFocusedColor="0x16191EFF" programTitleFont="font:SmallestSystemFont"
            timeLabelColor="0xA1A9B6FF" timeLabelFont="font:SmallestSystemFont" timeBarHeight="48"
            nowBarBlendColor="0x38BDF8FF" pastTimeScreenBitmapUri="pkg:/images/guide-past.9.png" visible="false" />
        </Group>
        <QuickGrid id="cards" translation="[624, 168]" itemComponentName="LiveCard" numColumns="4" numRows="3" itemSize="[282, 270]" itemSpacing="[24, 32]" drawFocusFeedback="false" vertFocusAnimationStyle="floatingFocus" visible="false" />
        <Label id="message" translation="[624, 480]" width="1200" wrap="true" horizAlign="center" color="0xA1A9B6FF" font="font:MediumSystemFont" />
        <!-- Under what failed with nothing to show. -->
        <ButtonGroup id="retry" focusBitmapUri="pkg:/images/button-focus.9.png" focusFootprintBitmapUri="pkg:/images/button-footprint.9.png" textColor="0xEBEBEBFF" focusedTextColor="0x16191EFF" iconUri="" focusedIconUri="" translation="[1064, 640]" minWidth="320" visible="false" />
        <Label id="hint" translation="[624, 980]" width="1200" horizAlign="right" color="0x8B95A5FF" font="font:TinySystemFont" />
        <!-- What's on moves on. -->
        <Timer id="clock" duration="15" repeat="true" />
    </children>
</component>
