<?xml version="1.0" encoding="utf-8"?>
<!-- Signing in with a code (docs/API.md, "TVs"): the TV shows a code and
     the address of the server's /link page, approved on a phone, and beside
     them that address with the code as a QR code, which the server draws.
     At the top right, on the logo's line, the globe picks the language. -->
<component name="LinkScreen" extends="Group">
    <interface>
        <field id="route" type="string" />
        <field id="params" type="assocarray" />
        <field id="navigate" type="assocarray" alwaysNotify="true" />
        <field id="active" type="boolean" alwaysNotify="true" />
        <!-- The language shown changed: the screen draws its words again. -->
        <field id="language" type="string" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/screens/LinkScreen.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/I18n.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Ui.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Url.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Http.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nav.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Auth.brs" />
    <children>
        <Label id="wordmark" translation="[96, 72]" text="Pley" color="0x38BDF8FF" font="font:ExtraLargeBoldSystemFont" />
        <Label id="title" translation="[96, 180]" width="1500" color="0xEBEBEBFF" font="font:ExtraLargeBoldSystemFont" />
        <Label id="server" translation="[96, 262]" width="1500" color="0xA1A9B6FF" font="font:SmallerSystemFont" />
        <Label id="intro" translation="[96, 306]" width="1500" color="0xEB6B70FF" visible="false" font="font:SmallerSystemFont" />
        <!-- Shown when the server requires two-step sign-in (older servers
             don't say): here, or below the intro when that shows, with the
             steps, the status and the buttons a line lower. -->
        <Label id="twoStep" translation="[96, 306]" width="1500" color="0xA1A9B6FF" visible="false" font="font:SmallerSystemFont" />
        <Group id="steps">
            <Label id="goTo" translation="[96, 380]" width="1248" color="0xEBEBEBFF" font="font:MediumSystemFont" />
            <Label id="url" translation="[96, 432]" width="1248" maxLines="2" color="0x7DD3FCFF" font="font:ExtraLargeBoldSystemFont" />
            <Label id="enterCode" translation="[96, 530]" width="1248" color="0xEBEBEBFF" font="font:MediumSystemFont" />
            <Rectangle id="codeBox" translation="[96, 586]" width="760" height="150" color="0x262B35FF" />
            <Label id="code" translation="[96, 586]" width="760" height="150" horizAlign="center" vertAlign="center" text="…" color="0xEBEBEBFF" font="font:LargestSystemFont" />
            <Label id="sameNetwork" translation="[96, 760]" width="1248" color="0x8B95A5FF" font="font:SmallestSystemFont" />
            <!-- Shown once it has loaded: older servers don't draw one. -->
            <Group id="qrBox" translation="[1384, 380]" visible="false">
                <Label id="scan" width="440" horizAlign="center" color="0xEBEBEBFF" font="font:MediumSystemFont" />
                <Poster id="qr" translation="[0, 52]" width="440" height="440" loadDisplayMode="scaleToFit" />
            </Group>
        </Group>
        <Label id="status" translation="[96, 812]" width="1248" wrap="true" maxLines="2" color="0xA1A9B6FF" font="font:MediumSystemFont" />
        <ButtonGroup id="actions" focusBitmapUri="pkg:/images/button-focus.9.png" focusFootprintBitmapUri="pkg:/images/button-footprint.9.png" textColor="0xEBEBEBFF" focusedTextColor="0x16191EFF" iconUri="" focusedIconUri="" translation="[96, 900]" layoutDirection="horiz" minWidth="380" />
        <Timer id="leave" duration="1.2" />
        <!-- Its letters end at the screen's right margin, centred on the
             logo's line. -->
        <LanguageGlobe id="globe" translation="[1838, 80]" />
        <LanguagePanel id="languages" />
    </children>
</component>
