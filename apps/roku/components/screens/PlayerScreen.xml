<?xml version="1.0" encoding="utf-8"?>
<!-- The player: the Video node with Pley's own controls over it (as the
     Android TV player's: PlayerControls), the picture subtitles the app
     draws, the title as each item begins, Skip Intro and Skip Credits, Up
     Next before the end of an episode (and at its end), the side panels
     the controls' buttons open (Subtitles with Subtitle sync and Find
     subtitles…, Audio, Quality, Chapters, Sleep timer, Info), the sleep
     timer's notice, Automatic's notice of a lower quality and the user's
     remote's of what it did, "Reconnecting…" while the server is out of
     reach, and what went wrong when it did. -->
<component name="PlayerScreen" extends="Group">
    <interface>
        <field id="route" type="string" />
        <field id="params" type="assocarray" />
        <field id="navigate" type="assocarray" alwaysNotify="true" />
        <field id="active" type="boolean" alwaysNotify="true" />
        <!-- A session stopped from elsewhere, as the event stream tells
             ({ session_id, message, by_admin }). -->
        <field id="serverStopped" type="assocarray" alwaysNotify="true" />
        <!-- A command of the user's remote, on another device, as the
             event stream tells it ({ session_id, command, position_ms,
             offset_ms }). -->
        <field id="playerCommand" type="assocarray" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/screens/PlayerScreen.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/I18n.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Ui.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Type.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Url.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Http.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nav.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nodes.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Format.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Player.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Remote.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Content.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/SubtitleSync.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Tracks.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/AutoQuality.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Details.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Media.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/SubtitleSearch.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Sleep.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Pictures.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Seeker.brs" />
    <children>
        <Rectangle width="1920" height="1080" color="0x000000FF" />
        <!-- The focus while nothing on the player has it (PlayerScreen.brs). -->
        <Group id="keys" />
        <Video id="video" width="1920" height="1080" enableUI="false">
            <!-- Picture subtitles (Pictures.brs): the one showing, and the
                 next loading in the other frame. Under the skip button and
                 the player's controls and panels, as captions are. -->
            <Group id="pictures">
                <Poster id="pictureA" opacity="0" loadDisplayMode="scaleToFit" />
                <Poster id="pictureB" opacity="0" loadDisplayMode="scaleToFit" />
            </Group>
            <!-- In the Video node, as Roku's own controls are: drawn
                 elsewhere, some Rokus put them under the picture. -->
            <PlayerControls id="controls" />
            <SkipButton id="skip" translation="[1544, 918]" visible="false" />
        </Video>
        <!-- The title for 4 s as each item begins, where the controls put
             it, over a band of black fading to clear (Android TV's title
             banner). -->
        <Group id="banner" visible="false">
            <Poster width="1920" height="240" uri="pkg:/images/ui/band-top.png" />
            <Label id="bannerTitle" translation="[96, 54]" width="1500" maxLines="1" color="0xEBEBEBFF" />
            <Label id="bannerLine" translation="[96, 106]" width="1500" maxLines="1" color="0xA1A9B6FF" />
        </Group>
        <!-- Up Next, as the Android TV player's card: 600 wide, its right
             edge at the safe area's and its bottom at y 978, the next one's
             still, its title, then Play now and Cancel. -->
        <Group id="upNext" translation="[1224, 330]" visible="false">
            <Poster width="600" height="648" uri="pkg:/images/ui/r12.9.png" blendColor="0x262B35F5" />
            <Poster id="nextImage" width="600" height="338" loadWidth="600" loadHeight="338" loadDisplayMode="scaleToZoom" />
            <Label id="upNextTitle" translation="[32, 362]" width="536" maxLines="1" color="0x38BDF8FF" />
            <Label id="nextTitle" translation="[32, 400]" width="536" maxLines="1" color="0xEBEBEBFF" />
            <Label id="nextLine" translation="[32, 448]" width="536" maxLines="1" color="0xA1A9B6FF" />
            <Label id="countdown" translation="[32, 488]" width="536" maxLines="1" color="0xA1A9B6FF" />
            <PillButtons id="nextButtons" layoutDirection="horiz" itemSpacings="[24]" translation="[32, 544]" minWidth="256" maxWidth="256" buttonHeight="72" />
        </Group>
        <!-- At the top, clear of the subtitles it moves. -->
        <Group id="sync" translation="[560, 72]" visible="false">
            <Poster width="800" height="236" uri="pkg:/images/ui/r12.9.png" blendColor="0x262B35F5" />
            <Label id="syncTitle" translation="[48, 40]" width="380" color="0x38BDF8FF" />
            <Label id="syncValue" translation="[48, 84]" width="340" color="0xEBEBEBFF" />
            <Label id="syncHint" translation="[48, 150]" width="360" wrap="true" maxLines="2" color="0xA1A9B6FF" />
            <PillButtons id="syncButtons" translation="[440, 48]" minWidth="312" />
        </Group>
        <!-- The side panel the controls' buttons open, as the Android TV
             player's: 720 wide from the right edge, square as menus are,
             over the picture dimmed behind it. Its choices (the current one
             checked), or the playback's details as text. -->
        <Group id="menu" visible="false">
            <Rectangle id="menuScrim" width="1920" height="1080" color="0x16191E80" />
            <!-- It slides in from the right over 200 ms, as Android TV's. -->
            <Group id="menuPanel">
                <Poster translation="[1200, 0]" width="720" height="1080" uri="pkg:/images/ui/panel.9.png" blendColor="0x1E222AFA" />
                <Label id="menuTitle" translation="[1256, 72]" width="608" maxLines="1" color="0xEBEBEBFF" />
                <QuickList id="menuList" translation="[1256, 152]" itemComponentName="PanelRow" itemSize="[608, 88]" itemSpacing="[0, 4]" numRows="8" drawFocusFeedback="false" vertFocusAnimationStyle="floatingFocus" />
                <Label id="menuText" translation="[1256, 152]" width="608" wrap="true" maxLines="20" lineSpacing="8" color="0xEBEBEBFF" visible="false" />
                <!-- The playback's details: each row's label and value. -->
                <FactSheet id="menuFacts" translation="[1256, 152]" width="608" height="780" labelWidth="200" visible="false" />
                <Label id="menuHint" translation="[1256, 936]" width="608" wrap="true" maxLines="2" color="0xA1A9B6FF" />
            </Group>
        </Group>
        <Animation id="menuSlide" duration="0.2" easeFunction="outCubic">
            <Vector2DFieldInterpolator key="[0, 1]" keyValue="[[720, 0], [0, 0]]" fieldToInterp="menuPanel.translation" />
            <FloatFieldInterpolator key="[0, 1]" keyValue="[0, 1]" fieldToInterp="menuScrim.opacity" />
        </Animation>
        <!-- A playback that stopped, centered on the screen's color, as the
             Android TV player says it: what happened, why, Try again where it
             may help, and Back. -->
        <Group id="notice" visible="false">
            <Rectangle width="1920" height="1080" color="0x16191EFF" />
            <Label id="noticeTitle" translation="[240, 360]" width="1440" horizAlign="center" wrap="true" maxLines="2" color="0xEBEBEBFF" />
            <Label id="noticeText" translation="[240, 450]" width="1440" horizAlign="center" wrap="true" maxLines="6" color="0xA1A9B6FF" />
            <PillButtons id="noticeButtons" layoutDirection="horiz" itemSpacings="[24]" translation="[0, 700]" minWidth="320" buttonHeight="72" />
        </Group>
        <!-- The sleep timer's last 30 s, at the bottom left on surface3, the
             moon before its count: Keep watching adds the same time again. -->
        <Group id="sleepNotice" translation="[96, 890]" visible="false">
            <Poster id="sleepBack" width="840" height="88" uri="pkg:/images/ui/r12.9.png" blendColor="0x2E3440FF" />
            <Poster translation="[40, 24]" width="40" height="40" uri="pkg:/images/ui/icon-moon-40.png" blendColor="0xA1A9B6FF" />
            <Label id="sleepText" translation="[100, 0]" width="360" height="88" vertAlign="center" color="0xEBEBEBFF" />
            <PillButtons id="sleepButtons" translation="[480, 8]" minWidth="320" buttonHeight="72" />
        </Group>
        <!-- Brief notices at the top right on surface3, as the Android TV
             player's toasts: Automatic saying it went down, and what the
             user's remote did ("Paused", "+30 s"). Under the clock while the
             controls show. -->
        <Group id="toast" visible="false">
            <Poster id="toastBack" height="76" uri="pkg:/images/ui/r12.9.png" blendColor="0x2E3440FF" />
            <Label id="toastText" translation="[40, 0]" height="76" vertAlign="center" wrap="true" maxLines="3" color="0xEBEBEBFF" />
        </Group>
        <Timer id="countdownTimer" duration="1" repeat="true" />
        <Timer id="toastTimer" duration="4" />
        <!-- The controls hide 5 s after the last key while it plays. -->
        <Timer id="hideTimer" duration="5" />
        <!-- A seek coming goes once its presses settle (Seeker.brs). -->
        <Timer id="settleTimer" />
        <!-- The seek badge, 0.6 s after the last press. -->
        <Timer id="badgeTimer" duration="0.6" />
        <!-- A key held: once it is (0.4 s), then the scrub's steps. -->
        <Timer id="holdTimer" repeat="true" />
        <!-- OK just after a seek confirms it, for 2 s. -->
        <Timer id="confirmTimer" duration="2" />
        <!-- The loading ring, 0.5 s into a wait. -->
        <Timer id="bufferingTimer" duration="0.5" />
        <!-- Progress told while paused (Player.brs). -->
        <Timer id="pausedTimer" repeat="true" />
        <!-- The sleep timer's look, once a second while it is set. -->
        <Timer id="sleepTimer" duration="1" repeat="true" />
        <!-- A picture subtitle track not whole yet, asked for again. -->
        <Timer id="picturesTimer" duration="3" />
        <!-- Automatic's look at the playback, once a second while it plays. -->
        <Timer id="autoTimer" duration="1" repeat="true" />
        <!-- The title's banner as an item begins. -->
        <Timer id="bannerTimer" duration="4" />
        <!-- The server asked again while it is out of reach. -->
        <Timer id="reconnectTimer" duration="2" />
        <!-- A look once a second at whether the playhead stands still. -->
        <Timer id="stallTimer" duration="1" repeat="true" />
        <!-- Playback details asked again while they show. -->
        <Timer id="detailsTimer" duration="2" repeat="true" />
    </children>
</component>
