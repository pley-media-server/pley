<?xml version="1.0" encoding="utf-8"?>
<!-- A library: its tabs (Recommended, Library, Collections), and on the
     Library tab its sort and filters, chosen in a panel at the right. The
     Library tab is a grid of posters loaded a page at a time, with the A to
     Z beside it when sorted by title; Recommended is the library's rows;
     Collections a grid of its collections. -->
<component name="LibraryScreen" extends="Group">
    <interface>
        <field id="route" type="string" />
        <field id="params" type="assocarray" />
        <field id="navigate" type="assocarray" alwaysNotify="true" />
        <field id="active" type="boolean" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/screens/LibraryScreen.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Ui.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Titles.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Url.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Http.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nav.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nodes.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Format.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Player.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Content.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Pages.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Library.brs" />
    <children>
        <Label id="title" translation="[96, 40]" width="1300" color="0xEBEBEBFF" font="font:ExtraLargeBoldSystemFont" />
        <Label id="count" translation="[1424, 60]" width="400" horizAlign="right" color="0xA1A9B6FF" font="font:SmallerSystemFont" />
        <ChipRow id="tabs" translation="[96, 132]" />
        <ChipRow id="view" translation="[1024, 132]" visible="false" />
        <MarkupGrid id="grid" translation="[96, 212]" itemComponentName="Tile" numColumns="7" numRows="2" itemSize="[220, 410]" itemSpacing="[28, 24]" drawFocusFeedback="false" vertFocusAnimationStyle="floatingFocus" visible="false" />
        <!-- The A to Z, right of the grid's last column. -->
        <LetterColumn id="letters" translation="[1812, 212]" visible="false" />
        <!-- A jump to a page that just came goes once the grid has taken
             in its titles: it passes over a place it doesn't know yet. -->
        <Timer id="jumpTimer" duration="0.1" />
        <RowList id="rows" translation="[96, 212]" itemComponentName="Tile" itemSize="[1728, 470]" numRows="2" itemSpacing="[0, 28]" rowItemSpacing="[[28, 0]]" showRowLabel="[true]" rowLabelOffset="[[0, 12]]" rowLabelColor="0xEBEBEBFF" drawFocusFeedback="false" rowFocusAnimationStyle="floatingFocus" vertFocusAnimationStyle="floatingFocus" rowLabelFont="font:MediumBoldSystemFont" visible="false" />
        <Label id="message" translation="[96, 480]" width="1728" wrap="true" horizAlign="center" color="0xA1A9B6FF" text="Loading…" font="font:MediumSystemFont" />
        <!-- The sort's or the filters' choices, over the right half. -->
        <Group id="panel" visible="false">
            <Rectangle translation="[1000, 0]" width="920" height="1080" color="0x1E222AFF" />
            <Label id="panelTitle" translation="[1056, 56]" width="808" color="0xEBEBEBFF" font="font:LargeBoldSystemFont" />
            <RadioButtonList id="choices" translation="[1056, 150]" itemSize="[808, 64]" numRows="11" color="0xEBEBEBFF" focusedColor="0x16191EFF" focusBitmapBlendColor="0x38BDF8FF" vertFocusAnimationStyle="floatingFocus" font="font:MediumSystemFont" focusedFont="font:MediumBoldSystemFont" />
            <!-- The filters: each opens its choices. -->
            <LabelList id="menu" translation="[1056, 150]" itemSize="[808, 64]" numRows="11" color="0xEBEBEBFF" focusedColor="0x16191EFF" focusBitmapBlendColor="0x38BDF8FF" vertFocusAnimationStyle="floatingFocus" font="font:MediumSystemFont" focusedFont="font:MediumBoldSystemFont" visible="false" />
            <Label id="panelHint" translation="[1056, 900]" width="808" wrap="true" maxLines="3" color="0xA1A9B6FF" font="font:SmallSystemFont" />
        </Group>
    </children>
</component>
