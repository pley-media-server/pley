<?xml version="1.0" encoding="utf-8"?>
<!-- Search with the on-screen keyboard; the recent searches before anything
     is typed; what the libraries have in rows by kind (Movies, Shows,
     Seasons, Episodes, Artists, Albums, Tracks, Live TV's channels as
     cards, People), then, where the person may ask for titles, Discover,
     ending with See all. -->
<component name="SearchScreen" extends="Group">
    <interface>
        <field id="route" type="string" />
        <field id="params" type="assocarray" />
        <field id="navigate" type="assocarray" alwaysNotify="true" />
        <field id="active" type="boolean" alwaysNotify="true" />
        <!-- The scene's: what requests let the profile do. -->
        <field id="requestSummary" type="assocarray" />
        <!-- Set by the scene: a title's request changed (its badge
             follows). -->
        <field id="requestNote" type="assocarray" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/screens/SearchScreen.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/I18n.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Ui.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/RequestBadges.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Url.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Http.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nav.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Titles.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nodes.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Format.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Player.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Content.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Pages.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Live.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Requests.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Search.brs" />
    <children>
        <Label id="title" translation="[192, 56]" color="0xE9EBEFFF" font="font:ExtraLargeBoldSystemFont" />
        <DynamicMiniKeyboard id="keyboard" translation="[192, 170]" />
        <!-- Each row's tiles are sized for its kind (lib/Search.brs's
             searchRowSize). -->
        <QuickRowList id="rows" translation="[852, 170]" itemComponentName="ResultTile" itemSize="[1044, 430]" rowItemSize="[[196, 370]]" numRows="2" itemSpacing="[0, 46]" rowItemSpacing="[[4, 0]]" showRowLabel="[true]" rowLabelOffset="[[24, 12]]" rowLabelColor="0xE9EBEFFF" drawFocusFeedback="false" rowFocusAnimationStyle="floatingFocus" vertFocusAnimationStyle="floatingFocus" rowLabelFont="font:MediumBoldSystemFont" visible="false" />
        <Label id="message" translation="[876, 200]" width="948" wrap="true" color="0xA1A9B6FF" font="font:MediumSystemFont" />
        <!-- Before anything is typed: the recent searches, then Clear, their
             words under the heading and in line with the results' row
             titles (a row's words are 32 in from its focus). -->
        <Label id="recentTitle" translation="[876, 170]" color="0xE9EBEFFF" visible="false">
            <Font role="font" uri="pkg:/fonts/roboto-700.ttf" size="36" />
        </Label>
        <QuickList id="recent" translation="[844, 236]" itemComponentName="PanelRow" itemSize="[640, 64]" itemSpacing="[0, 4]" numRows="11" drawFocusFeedback="false" vertFocusAnimationStyle="floatingFocus" visible="false" />
        <Timer id="debounce" duration="0.5" />
    </children>
</component>
