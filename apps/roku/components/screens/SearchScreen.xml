<?xml version="1.0" encoding="utf-8"?>
<!-- Search with the on-screen keyboard; the Live TV channels found as a row
     of cards (OK watches one), the titles and people as posters. Where the
     person may ask for titles, the libraries' and TMDB's are two rows, In
     your libraries and Discover, the second ending with See all. -->
<component name="SearchScreen" extends="Group">
    <interface>
        <field id="route" type="string" />
        <field id="params" type="assocarray" />
        <field id="navigate" type="assocarray" alwaysNotify="true" />
        <field id="active" type="boolean" alwaysNotify="true" />
        <!-- The scene's: what requests let the profile do. -->
        <field id="requestSummary" type="assocarray" />
        <!-- Set by the scene: a title's request changed (its badge
             follows). -->
        <field id="requestNote" type="assocarray" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/screens/SearchScreen.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Ui.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/RequestBadges.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Url.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Http.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nav.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Titles.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nodes.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Format.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Player.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Content.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Pages.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Live.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Requests.brs" />
    <children>
        <Label id="title" translation="[96, 56]" text="Search" color="0xEBEBEBFF" font="font:ExtraLargeBoldSystemFont" />
        <DynamicMiniKeyboard id="keyboard" translation="[96, 170]" />
        <!-- The Live TV channels found. -->
        <RowList id="live" translation="[780, 150]" itemComponentName="LiveCard" itemSize="[1040, 300]" numRows="1" rowItemSize="[[220, 240]]" rowItemSpacing="[[24, 0]]" showRowLabel="[true]" rowLabelOffset="[[0, 12]]" rowLabelColor="0xEBEBEBFF" drawFocusFeedback="false" rowFocusAnimationStyle="floatingFocus" rowLabelFont="font:MediumBoldSystemFont" visible="false" />
        <MarkupGrid id="grid" translation="[780, 170]" itemComponentName="Tile" numColumns="5" numRows="2" itemSize="[196, 370]" itemSpacing="[24, 28]" drawFocusFeedback="false" vertFocusAnimationStyle="floatingFocus" visible="false" />
        <RowList id="rows" translation="[780, 170]" itemComponentName="Tile" itemSize="[1044, 430]" rowItemSize="[[196, 370]]" numRows="2" itemSpacing="[0, 20]" rowItemSpacing="[[24, 0]]" showRowLabel="[true]" rowLabelOffset="[[0, 12]]" rowLabelColor="0xEBEBEBFF" drawFocusFeedback="false" rowFocusAnimationStyle="floatingFocus" vertFocusAnimationStyle="floatingFocus" rowLabelFont="font:MediumBoldSystemFont" visible="false" />
        <Label id="message" translation="[780, 200]" width="1040" wrap="true" color="0xA1A9B6FF" text="Type to search your libraries." font="font:MediumSystemFont" />
        <Timer id="debounce" duration="0.5" />
    </children>
</component>
