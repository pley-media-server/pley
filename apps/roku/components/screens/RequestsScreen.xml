<?xml version="1.0" encoding="utf-8"?>
<!-- The requests: Your requests (the account's own and those it follows),
     or a manager's Requests (everyone's, opening on Needs attention, with
     filters in a panel at the right). Tabs by status; a row for each
     request with its poster, its stage and what to know of it. OK opens
     the title's page; the Options key offers what can be done with the
     request. Each tab says how many it holds. -->
<component name="RequestsScreen" extends="Group">
    <interface>
        <field id="route" type="string" />
        <field id="params" type="assocarray" />
        <field id="navigate" type="assocarray" alwaysNotify="true" />
        <field id="active" type="boolean" alwaysNotify="true" />
        <!-- The scene's: what requests let the profile do. -->
        <field id="requestSummary" type="assocarray" />
        <!-- Set by the scene: requests changed (the list asks again). -->
        <field id="requestsChanged" type="assocarray" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/screens/RequestsScreen.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Paint.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Colors.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/I18n.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Type.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/Ui.brs" />
    <script type="text/brightscript" uri="pkg:/components/shared/RequestActions.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Url.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Http.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nav.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Nodes.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Format.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Player.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Content.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Requests.brs" />
    <children>
        <Label id="heading" translation="[192, 54]" width="1000" color="0xE9EBEFFF" font="font:ExtraLargeBoldSystemFont" />
        <!-- How many there are; for an administrator whose sign-in can't
             approve, how to make it. -->
        <Label id="count" translation="[1024, 74]" width="800" horizAlign="right" color="0xA1A9B6FF" font="font:SmallerSystemFont" />
        <!-- Closer chips than a library's: a manager's eight tabs leave
             room for the filters (closer still where their numbers need
             it). -->
        <ChipRow id="tabs" translation="[192, 132]" pad="44" visible="false" />
        <!-- A manager's filters, or Sign in again. -->
        <ChipRow id="side" translation="[1600, 132]" pad="44" visible="false" />
        <QuickList id="list" translation="[192, 244]" itemComponentName="RequestRow" itemSize="[1632, 176]" itemSpacing="[0, 12]" numRows="4" drawFocusFeedback="false" vertFocusAnimationStyle="floatingFocus" />
        <Label id="message" translation="[192, 480]" width="1632" wrap="true" horizAlign="center" color="0xA1A9B6FF" font="font:MediumSystemFont" />
        <Label id="hint" translation="[192, 1000]" width="1632" color="0x7E8795FF" visible="false" font="font:SmallestSystemFont" />
        <!-- Why the requests can't be shown, and what to do about it. -->
        <LayoutGroup id="problem" translation="[192, 360]" layoutDirection="vert" itemSpacings="[20, 48]" visible="false">
            <Label id="problemTitle" width="1400" wrap="true" color="0xE9EBEFFF" font="font:LargeBoldSystemFont" />
            <Label id="problemText" width="1400" wrap="true" color="0xA1A9B6FF" font="font:MediumSystemFont" />
            <PillButtons id="problemButtons" minWidth="420" />
        </LayoutGroup>
        <!-- The filters, each opening its choices, over the right half. -->
        <Group id="panel" visible="false">
            <Rectangle id="dim" width="1920" height="1080" />
            <Poster translation="[1200, 0]" width="720" height="1080" uri="pkg:/images/ui/panel.9.png" blendColor="0x12151AFF" />
            <Label id="panelTitle" translation="[1256, 72]" width="608" maxLines="1" color="0xE9EBEFFF" />
            <QuickList id="choices" translation="[1256, 152]" itemComponentName="PanelRow" itemSize="[608, 88]" itemSpacing="[0, 4]" numRows="8" drawFocusFeedback="false" vertFocusAnimationStyle="floatingFocus" />
            <QuickList id="menu" translation="[1256, 152]" itemComponentName="PanelRow" itemSize="[608, 88]" itemSpacing="[0, 4]" numRows="8" drawFocusFeedback="false" vertFocusAnimationStyle="floatingFocus" visible="false" />
        </Group>
        <!-- The list asked again while one of its requests downloads, or
             while the event stream is down. -->
        <Timer id="busy" duration="10" />
    </children>
</component>
