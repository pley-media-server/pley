<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings version="1">
  <section id="plugin.video.pley">
    <category id="server" label="30040">
      <group id="1">
        <setting id="server_name" type="string" label="30042">
          <level>0</level>
          <default/>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <control type="edit" format="string">
            <heading>30042</heading>
          </control>
        </setting>
        <setting id="server_url" type="string" label="30041">
          <level>0</level>
          <default/>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <control type="edit" format="string">
            <heading>30041</heading>
          </control>
        </setting>
        <setting id="server_id" type="string">
          <level>4</level>
          <default/>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <visible>false</visible>
          <control type="edit" format="string"/>
        </setting>
      </group>
      <group id="2">
        <setting id="choose_server" type="action" label="30000">
          <level>0</level>
          <data>RunPlugin(plugin://plugin.video.pley/?route=choose_server)</data>
          <control type="button" format="action">
            <close>true</close>
          </control>
        </setting>
        <setting id="sign_in" type="action" label="30010">
          <level>0</level>
          <data>RunPlugin(plugin://plugin.video.pley/?route=sign_in)</data>
          <control type="button" format="action">
            <close>true</close>
          </control>
        </setting>
        <setting id="switch_profile" type="action" label="30220">
          <level>0</level>
          <data>RunPlugin(plugin://plugin.video.pley/?route=profiles)</data>
          <control type="button" format="action">
            <close>true</close>
          </control>
        </setting>
        <setting id="profile_language" type="action" label="30601">
          <level>0</level>
          <data>RunPlugin(plugin://plugin.video.pley/?route=language)</data>
          <control type="button" format="action">
            <close>true</close>
          </control>
        </setting>
        <setting id="sign_out" type="action" label="30002">
          <level>0</level>
          <data>RunPlugin(plugin://plugin.video.pley/?route=sign_out)</data>
          <control type="button" format="action">
            <close>true</close>
          </control>
        </setting>
      </group>
    </category>
    <category id="look" label="30161">
      <group id="1">
        <setting id="look" type="integer" label="30161">
          <level>0</level>
          <default>0</default>
          <constraints>
            <options>
              <option label="30162">0</option>
              <option label="30163">1</option>
            </options>
          </constraints>
          <control type="list" format="string">
            <heading>30161</heading>
          </control>
        </setting>
      </group>
      <group id="2">
        <!-- This device's language: Automatic is Kodi's where Pley has it,
             else the server's; a profile's own language comes first. -->
        <setting id="language" type="string" label="30600">
          <level>0</level>
          <default>auto</default>
          <constraints>
            <options>
              <option label="30607">auto</option>
              <option label="30602">en</option>
              <option label="30603">fr</option>
              <option label="30604">es</option>
            </options>
          </constraints>
          <control type="list" format="string">
            <heading>30600</heading>
          </control>
        </setting>
      </group>
    </category>
    <category id="playback" label="30043">
      <group id="1">
        <setting id="video_quality" type="string" label="30044">
          <level>0</level>
          <default>auto</default>
          <constraints>
            <options>
              <option label="30045">original</option>
              <option label="30212">auto</option>
              <option label="30046">30m</option>
              <option label="30048">15m</option>
              <option label="30047">20m</option>
              <option label="30049">12m</option>
              <option label="30050">8m</option>
              <option label="30051">4m</option>
              <option label="30052">2m</option>
            </options>
          </constraints>
          <control type="list" format="string">
            <heading>30044</heading>
          </control>
        </setting>
        <!-- The quality before Automatic, an index into the old order:
             carried over to video_quality once (playback.chosen_quality). -->
        <setting id="quality" type="integer">
          <level>4</level>
          <default>0</default>
          <visible>false</visible>
          <control type="edit" format="integer"/>
        </setting>
      </group>
      <group id="2">
        <setting id="tracks" type="action" label="30195">
          <level>0</level>
          <data>RunPlugin(plugin://plugin.video.pley/?route=tracks)</data>
          <control type="button" format="action">
            <close>true</close>
          </control>
        </setting>
      </group>
    </category>
  </section>
</settings>
