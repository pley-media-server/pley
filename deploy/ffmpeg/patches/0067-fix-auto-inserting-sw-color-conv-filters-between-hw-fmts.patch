From: the jellyfin-ffmpeg contributors
Subject: fix auto inserting sw color conv filters between hw fmts
Origin: https://github.com/jellyfin/jellyfin-ffmpeg/blob/v8.1.3-2/debian/patches/0067-fix-auto-inserting-sw-color-conv-filters-between-hw-fmts.patch

ffmpeg adds no software colour conversion behind a filter graph that
ends in hardware frames, which it can't convert.

Rebased onto FFmpeg 9.0.2: the same change, at 9.0.2's line numbers.

From jellyfin-ffmpeg 8.1.3-2, where the patch has no header: its authors
are in that repository's history. Under FFmpeg's licence, as the files
it changes.
---
diff --git a/fftools/ffmpeg_filter.c b/fftools/ffmpeg_filter.c
--- a/fftools/ffmpeg_filter.c
+++ b/fftools/ffmpeg_filter.c
@@ -1701,9 +1701,22 @@ static int configure_output_video_filter
                ofp->format != AV_PIX_FMT_NONE || !ofp->pix_fmts);
     av_bprint_init(&bprint, 0, AV_BPRINT_SIZE_UNLIMITED);
     choose_pix_fmts(ofp, &bprint);
-    choose_color_spaces(ofp, &bprint);
-    choose_color_ranges(ofp, &bprint);
-    choose_alpha_modes(ofp, &bprint);
+    /* SW filter cannot handle color conversions between HW pixel formats. */
+    {
+        int bprint_color_options = 1;
+        if (ofp->format != AV_PIX_FMT_NONE) {
+            const AVPixFmtDescriptor *ofp_fmt_desc;
+
+            ofp_fmt_desc = av_pix_fmt_desc_get(ofp->format);
+            if (ofp_fmt_desc->flags & AV_PIX_FMT_FLAG_HWACCEL)
+                bprint_color_options = 0;
+        }
+        if (bprint_color_options) {
+            choose_color_spaces(ofp, &bprint);
+            choose_color_ranges(ofp, &bprint);
+            choose_alpha_modes(ofp, &bprint);
+        }
+    }
     if (!av_bprint_is_complete(&bprint))
         return AVERROR(ENOMEM);
 
