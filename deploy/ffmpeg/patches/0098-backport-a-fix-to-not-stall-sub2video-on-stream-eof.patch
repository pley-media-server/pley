From: the jellyfin-ffmpeg contributors
Subject: backport a fix to not stall sub2video on stream eof
Origin: https://github.com/jellyfin/jellyfin-ffmpeg/blob/v8.1.3-2/debian/patches/0098-backport-a-fix-to-not-stall-sub2video-on-stream-eof.patch

ffmpeg doesn't stall when a subtitle stream that feeds a filter graph
ends before the graph is configured.

Rebased onto FFmpeg 9.0.2: the same change, at 9.0.2's line numbers.

From jellyfin-ffmpeg 8.1.3-2, where the patch has no header: its authors
are in that repository's history. Under FFmpeg's licence, as the files
it changes.
---
diff --git a/fftools/ffmpeg_filter.c b/fftools/ffmpeg_filter.c
--- a/fftools/ffmpeg_filter.c
+++ b/fftools/ffmpeg_filter.c
@@ -2200,7 +2200,7 @@ static int configure_filtergraph(FilterG
         AVFrame *tmp;
         while (av_fifo_read(ifp->frame_queue, &tmp, 1) >= 0) {
             if (ifp->type_src == AVMEDIA_TYPE_SUBTITLE) {
-                sub2video_frame(&ifp->ifilter, tmp, !fgt->graph);
+                ret = sub2video_frame(&ifp->ifilter, tmp, !fgt->graph);
             } else {
                 if (ifp->type_src == AVMEDIA_TYPE_VIDEO) {
                     if (ifp->displaymatrix_applied)
@@ -2969,16 +2969,17 @@ static int sub2video_frame(InputFilter *
     int ret;
 
     if (buffer) {
-        AVFrame *tmp;
-
-        if (!frame)
-            return 0;
+        // queue a NULL entry for EOF, so it is not lost when
+        // the queue is replayed after configuring the graph
+        AVFrame *tmp = NULL;
+
+        if (frame) {
+            tmp = av_frame_alloc();
+            if (!tmp)
+                return AVERROR(ENOMEM);
 
-        tmp = av_frame_alloc();
-        if (!tmp)
-            return AVERROR(ENOMEM);
-
-        av_frame_move_ref(tmp, frame);
+            av_frame_move_ref(tmp, frame);
+        }
 
         ret = av_fifo_write(ifp->frame_queue, &tmp, 1);
         if (ret < 0) {
