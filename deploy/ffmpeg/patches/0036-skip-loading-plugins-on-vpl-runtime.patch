From: the jellyfin-ffmpeg contributors
Subject: skip loading plugins on vpl runtime
Origin: https://github.com/jellyfin/jellyfin-ffmpeg/blob/v8.1.3-2/debian/patches/0036-skip-loading-plugins-on-vpl-runtime.patch

Quick Sync's plugins aren't loaded on the oneVPL runtime, which has
none.

Rebased onto FFmpeg 9.0.2: the same change, at 9.0.2's line numbers.

From jellyfin-ffmpeg 8.1.3-2, where the patch has no header: its authors
are in that repository's history. Under FFmpeg's licence, as the files
it changes.
---
diff --git a/libavcodec/qsv.c b/libavcodec/qsv.c
--- a/libavcodec/qsv.c
+++ b/libavcodec/qsv.c
@@ -409,9 +409,17 @@ static int qsv_load_plugins(mfxSession s
                             void *logctx)
 {
 #if QSV_HAVE_USER_PLUGIN
+    mfxVersion ver;
     if (!load_plugins || !*load_plugins)
         return 0;
 
+    // Plugins have been removed in VPL runtime, don't load them
+    // if using the VPL runtime with MSDK loader to avoid failure.
+    if (MFXQueryVersion(session, &ver) == MFX_ERR_NONE &&
+        QSV_RUNTIME_VERSION_ATLEAST(ver, 1, 255)) {
+        return 0;
+    }
+
     while (*load_plugins) {
         mfxPluginUID uid;
         mfxStatus ret;
