From: the jellyfin-ffmpeg contributors
Subject: skip oversized a53 caption sei in qsv h264 encoder
Origin: https://github.com/jellyfin/jellyfin-ffmpeg/blob/v8.1.3-2/debian/patches/0105-skip-oversized-a53-caption-sei-in-qsv-h264-encoder.patch

h264_qsv leaves out closed captions too large for one SEI message
instead of writing a broken one.

Rebased onto FFmpeg 9.0.2: the same change, at 9.0.2's line numbers.

From jellyfin-ffmpeg 8.1.3-2, where the patch has no header: its authors
are in that repository's history. Under FFmpeg's licence, as the files
it changes.
---
diff --git a/libavcodec/qsvenc_h264.c b/libavcodec/qsvenc_h264.c
--- a/libavcodec/qsvenc_h264.c
+++ b/libavcodec/qsvenc_h264.c
@@ -27,6 +27,7 @@
 #include <mfxvideo.h>
 
 #include "libavutil/common.h"
+#include "libavutil/mem.h"
 #include "libavutil/opt.h"
 
 #include "avcodec.h"
@@ -56,6 +57,14 @@ static int qsv_h264_set_encode_ctrl(AVCo
         if (res < 0 || !payload)
             return res;
 
+        if (sei_size >= UINT8_MAX) {
+            av_log(avctx, AV_LOG_VERBOSE,
+                   "A53 caption SEI payload is too large "
+                   "(%zu bytes), skipping\n", sei_size);
+            av_free(payload);
+            return 0;
+        }
+
         sei_data = (mfxU8*)(payload + 1);
         // SEI header
         sei_data[0] = 4;
