# Pley's Docker settings. setup.sh copies this file to .env and fills in the
# user and the GPU lines; or copy it yourself. Every line is optional.
# Paths may contain spaces and need no quotes.

# Where Pley keeps its database, artwork, caches and transcodes (back it up).
# A folder outside this checkout, such as /srv/pley, survives `git clean -x`.
PLEY_CONFIG_DIR=./config

# Your media, mounted read-only at /media in the container: libraries are
# folders under /media, such as /media/Movies. media/README.md shows how to
# name files. Several disks: see "More media folders" in README.md.
PLEY_MEDIA_DIR=./media

# The user and group Pley runs as (`id -u` and `id -g`): they must be able to
# write the config folder and read the media. Never 0 (root), except with
# rootless Docker, where 0 in the container is you.
PLEY_UID=1000
PLEY_GID=1000

# Where Pley's web port is published. 127.0.0.1 keeps it to this computer, for
# a reverse proxy here; for a proxy on another machine use this computer's LAN
# address (192.168.1.10:7539) or 0.0.0.0:7539 (every address).
PLEY_LISTEN=127.0.0.1:7539

# Add-ons, each a compose file (README.md): separate them with ":", or ";" on
# Windows.
#   compose.vaapi.yaml   Intel or AMD hardware transcoding (PLEY_RENDER_GID)
#   compose.nvidia.yaml  NVIDIA hardware transcoding (NVIDIA Container Toolkit)
#   compose.proxy.yaml   a reverse proxy in Docker: no published port
#   compose.jellyfin.yaml the Jellyfin-compatible API on port 8096 (PLEY_JELLYFIN_LISTEN)
# COMPOSE_FILE=compose.yaml:compose.vaapi.yaml

# compose.vaapi.yaml: the render node's group (stat -c %g /dev/dri/renderD128;
# never 0, root's group) and, with several GPUs, which one.
# PLEY_RENDER_GID=
# PLEY_RENDER_DEVICE=/dev/dri/renderD128

# compose.proxy.yaml: the Docker network the proxy is on.
# PLEY_PROXY_NETWORK=proxy

# compose.jellyfin.yaml: where the Jellyfin-compatible API is published.
# PLEY_JELLYFIN_LISTEN=127.0.0.1:8096

# The image: built from this checkout (default), or a published release with
# PLEY_IMAGE=ghcr.io/pley-media-server/pley:<version> and PLEY_PULL_POLICY=missing.
# PLEY_IMAGE=pley:local
# PLEY_PULL_POLICY=build

# /dev/shm's size: transcodes keep their segments in half of it, taken only
# as they are made (Settings → Transcoder → Transcode in memory).
# PLEY_SHM_SIZE=2gb

# Log detail: info, or debug when something goes wrong.
# PLEY_LOG=info
