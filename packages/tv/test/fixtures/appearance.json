      "pick": { "theme": "greenlight", "accent": "amber" },
      "out": { "pley.theme.http://pley.local:7539.7": "greenlight", "pley.accent.http://pley.local:7539.7": "amber", "pley.theme.http://pley.local:7539.9": "midday" }
    },
    {
      "name": "the theme's own accent keeps no accent",
      "kept": { "pley.theme.http://pley.local:7539.7": "greenlight", "pley.accent.http://pley.local:7539.7": "amber" },
      "profile": { "server": "http://pley.local:7539", "id": 7 },
      "pick": { "theme": "greenlight", "accent": null },
