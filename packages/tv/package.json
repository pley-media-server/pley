{
  "name": "pley-tv",
  "private": true,
  "description": "Pley for Samsung TV's screens, sign-in, capabilities, playback sessions and subtitles. The app (apps/tizen) adds the TV's player and probes.",
  "type": "module",
  "exports": {
    ".": "./src/index.tsx",
    "./build": "./build/build-app.mjs",
    "./*": "./src/*"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "tsc -p tsconfig.json && vitest run"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@preact/signals": "^2.11.3",
    "lucide": "^1.61.0",
    "pley-picture-subtitles": "*",
    "preact": "^11.0.2",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
